---
import { RootLayout } from '@/components/layouts/root';
import { PartnerFormTrigger } from '@/components/partner-form-trigger';
import { Seo } from '@/components/seo';
import Breadcrumbs from '@/components/ui/breadcrumbs.astro';
import Button from '@/components/ui/button.svelte';
import IconDownload from '@/components/ui/icon-download.svelte';
import SectHeadingAccent from '@/components/ui/sect-heading-accent.svelte';
import SectHeading from '@/components/ui/sect-heading.svelte';
import { getCharityProgramBySlug } from '@/lib/data/charityPrograms';
import { getPartners } from '@/lib/data/partners';
import { getSiteSeo } from '@/lib/data/siteSeo';

const siteSeo = await getSiteSeo(Astro);
const seo = siteSeo.find(item => item.slug === 'socialnye-lifty');
const program = await getCharityProgramBySlug(Astro, 'socialnye-lifty');
const partners = await getPartners(Astro);
const currentUrl = Astro.url.pathname;

const breadcrumbs = [
  {
    url: '/',
    name: 'Главная',
  },
  {
    url: '/programs',
    name: 'Программы',
  },
  {
    url: '/programs/socialnye-lifty',
    name: 'Социальные лифты',
  },
];
---

<RootLayout>
  <!-- <ViewTransitions  slot={'head'}/> -->
  <Seo
    slot={'seo'}
    title={seo?.name || 'Социальные лифты'}
    description={seo?.description || ''}
    imageUrls={{ fb: seo?.image || '' }}
  />

  <main>
    <section class="py-8 xl:pb-20 xl:pt-5">
      <div class="container">
        <Breadcrumbs {breadcrumbs} />
        <div class="flex justify-between items-start flex-wrap gap-4">
          <SectHeading
            className="max-w-xl mb-4 md:mb-4 text-balance flex-grow"
            level={1}
          >
            <SectHeadingAccent>{program.name}</SectHeadingAccent>
          </SectHeading>
          <div
            class="flex flex-col gap-4 xl:order-none order-1 mt-4 xl:mt-0 w-full lg:w-auto"
          >
            <PartnerFormTrigger className="w-full" client:load
              >Стать партнёром</PartnerFormTrigger
            >
            {
              program.presentation && (
                <Button
                  variant="outline"
                  className=" hover:text-accent transition-colors"
                  external
                  href={program.presentation.toString()}
                >
                  <IconDownload class="text-2xl text-accent" /> Скачать
                  программу
                </Button>
              )
            }
          </div>
          <div
            class="flex-grow text-sm font-thin md:text-base max-w-3xl"
            set:html={program.description}
          />
        </div>

        {
          partners.map(partner => {
            if (
              partner.events?.length &&
              partner.events.some(
                event => event.charityProgram.slug === 'socialnye-lifty',
              )
            )
              return (
                <article class="grid grid-cols-1 md:grid-cols-[auto,1fr,1fr] grid-rows-[auto,auto,auto] gap-5 mt-10 first-of-type:mt-20">
                  <div class="bg-white/90 w-40 h-40 row-span-3  rounded-full md:sticky top-24 lg:top-28 overflow-clip p-3">
                    <img
                      width="160"
                      height="160"
                      class="w-full h-full object-contain object-center"
                      src={partner.image.toString()}
                      alt={partner.name}
                    />
                  </div>
                  <SectHeading className="col-span-2 text-xl xs:text-xl sm:text-xl md:text-2xl !mb-0">
                    <SectHeadingAccent>
                      <a href={`/partners/${partner.id}`}>{partner.name}</a>
                    </SectHeadingAccent>
                  </SectHeading>
                  <div class="col-span-2 lg:col-span-1">
                    <h3 class="text-xl mb-1">О предприятии:</h3>
                    <div class="prose">
                      <p>{partner.description}</p>
                    </div>
                  </div>
                  <div class="col-span-2 lg:col-span-1">
                    <h3 class="text-xl mb-1">Совместное участие:</h3>
                    <ul class="list-disc list-inside">
                      {partner.events
                        .filter(
                          event =>
                            event.charityProgram.slug === 'socialnye-lifty',
                        )
                        .map(event => (
                          <li class="font-thin text-sm md:text-base mt-1 first-of-type:mt-0 relative">
                            {!event.draft && (
                              <a
                                href={`/news/${event.slug}?from=${encodeURIComponent(currentUrl)}`}
                                class="absolute inset-0 opacity-0"
                              >
                                .
                              </a>
                            )}
                            <strong>{event.title}</strong>
                            <br />
                            {event.description}
                          </li>
                        ))}
                    </ul>
                  </div>
                </article>
              );
          })
        }
      </div>
    </section>
  </main>
</RootLayout>

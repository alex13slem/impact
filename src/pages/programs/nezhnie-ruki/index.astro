---
import { RootLayout } from '@/components/layouts/root';
import { Seo } from '@/components/seo';
import Breadcrumbs from '@/components/ui/breadcrumbs.astro';
import SectHeadingAccent from '@/components/ui/sect-heading-accent.svelte';
import SectHeading from '@/components/ui/sect-heading.svelte';
import { getCharityProgramBySlug } from '@/lib/data/charityPrograms';
import { getNews } from '@/lib/data/news';
import { getSiteSeo } from '@/lib/data/siteSeo';
import { InteractiveBlock } from './_interactive-block';

const siteSeo = await getSiteSeo(Astro);
const seo = siteSeo.find(item => item.slug === 'nezhnie-ruki');
const categoryNews = (await getNews(Astro)).filter(
  n => n.charityProgram.slug === 'nezhnie-ruki',
);
const breadcrumbs = [
  {
    url: '/',
    name: 'Главная',
  },
  {
    url: '/programs',
    name: 'Программы',
  },
  {
    url: '/programs/nezhnie-ruki',
    name: 'Нежные руки',
  },
];
// const program = await getCharityProgramBySlug(Astro, 'nezhnie-ruki');
---

<RootLayout>
  <Seo
    slot={'seo'}
    title={seo?.name || 'Нежные руки'}
    description={seo?.description || ''}
    imageUrls={{ fb: seo?.image || '' }}
  />

  <main>
    <section class="py-8 xl:pb-20 xl:pt-5">
      <div class="container">
        <Breadcrumbs {breadcrumbs} />
        <div class="flex justify-between items-start flex-col gap-4">
          <SectHeading
            className="max-w-4xl mb-4 md:mb-4 text-balance flex-grow"
            level={1}
          >
            <!-- <SectHeadingAccent>{program.name}</SectHeadingAccent> -->
          </SectHeading>

          <!-- <div
            class="flex-grow text-sm font-thin md:text-base max-w-3xl"
            set:html={program.description}
          /> -->
        </div>
        <InteractiveBlock className="mt-8" news={categoryNews} client:load />
      </div>
    </section>
  </main>
</RootLayout>

---
import { RootLayout } from '@/components/layouts/root';
import { Seo } from '@/components/seo';
import Breadcrumbs from '@/components/ui/breadcrumbs.astro';
import Button from '@/components/ui/button.svelte';
import IconDownload from '@/components/ui/icon-download.svelte';
import IconDocs from '@/components/ui/icons/icon-docs.svelte';
import SectHeadingAccent from '@/components/ui/sect-heading-accent.svelte';
import SectHeading from '@/components/ui/sect-heading.svelte';
import { WardsSlider } from '@/components/wards-slider';
import { getCharityProgramBySlug } from '@/lib/data/charityPrograms';
import { getDocs } from '@/lib/data/docs';
import { getSiteSeo } from '@/lib/data/siteSeo';
import { getWardsWithRelatedDataByCharity } from '@/lib/data/wards';
import { cn } from '@/lib/utils';

const wards = await getWardsWithRelatedDataByCharity(Astro, 'pomozj-detyam');
const program = await getCharityProgramBySlug(Astro, 'pomozj-detyam');
const docs = await getDocs(Astro);
const viewDocs = docs.filter(doc => doc.showIn === 'pomozj-detyam');

const siteSeo = await getSiteSeo(Astro);
const seo = siteSeo.find(item => item.slug === 'pomozj-detyam');

const breadcrumbs = [
  {
    url: '/',
    name: 'Главная',
  },
  {
    url: '/programs',
    name: 'Программы',
  },
  {
    url: '/programs/pomozj-detyam',
    name: 'Помощь детям',
  },
];
---

<RootLayout>
  <Seo
    slot={'seo'}
    title={seo?.name || 'Помощь тяжелобольным детям'}
    description={seo?.description || ''}
    imageUrls={{ fb: seo?.image || '' }}
  />

  <main>
    <section class="py-8 xl:pb-20 xl:pt-5">
      <div class="container">
        <Breadcrumbs {breadcrumbs} />
        <div class="flex justify-between items-start flex-wrap gap-4">
          <SectHeading
            className="max-w-4xl mb-4 md:mb-4 text-balance flex-grow"
            level={1}
          >
            <SectHeadingAccent>{program.name}</SectHeadingAccent>
          </SectHeading>
          <div
            class="flex flex-col gap-4 xl:order-none order-1 mt-4 xl:mt-0 w-full lg:w-auto"
          >
            {
              !!viewDocs && (
                <Button variant="accent" href="/programs/pomozj-detyam/docs">
                  <IconDocs class="text-2xl text-dark" /> Документы для подачи
                  заявки
                </Button>
              )
            }
            {
              program.presentation && (
                <Button
                  variant="outline"
                  className=" hover:text-accent transition-colors"
                  external
                  href={program.presentation.toString()}
                >
                  <IconDownload class="text-2xl text-accent" /> Скачать
                  программу
                </Button>
              )
            }
          </div>
          <div
            class="flex-grow text-sm font-thin md:text-base max-w-3xl"
            set:html={program.description}
          />
        </div>

        <SectHeading className="!text-4xl !mt-16 !mb-8 "
          >Наши <SectHeadingAccent>подопечные</SectHeadingAccent></SectHeading
        >
        <div class="relative">
          <WardsSlider {wards} client:load />
          {
            ['prev', 'next'].map(dir => (
              <button
                class={cn(
                  {
                    'prev-btn left-0  rotate-180': dir === 'prev',
                    'next-btn right-0  ': dir === 'next',
                  },
                  'bg-white/90 text-dark absolute top-1/2 -translate-y-1/2 z-20  rounded-full  p-3 disabled:opacity-0 hover:bg-white transition-colors hidden xl:inline-block',
                )}
              >
                <svg
                  width="1em"
                  height="1em"
                  viewBox="0 0 12.6865 9.69238"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                  xmlns:xlink="http://www.w3.org/1999/xlink"
                >
                  <path
                    d="M7.48 0.35L11.97 4.84L7.48 9.33M11.97 4.84L0 4.84"
                    stroke="currentColor"
                    stroke-opacity="1"
                    stroke-width="1"
                  />
                </svg>
              </button>
            ))
          }
        </div>
      </div>
    </section>
  </main>
</RootLayout>

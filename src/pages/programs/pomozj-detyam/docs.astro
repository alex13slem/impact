---
import { RootLayout } from '@/components/layouts/root';
import { Seo } from '@/components/seo';
import Breadcrumbs from '@/components/ui/breadcrumbs.astro';
import SectHeadingAccent from '@/components/ui/sect-heading-accent.svelte';
import SectHeading from '@/components/ui/sect-heading.svelte';
import { ViewDocs } from '@/components/view-docs';
import { getDocs } from '@/lib/data/docs';
import { getSiteSeo } from '@/lib/data/siteSeo';

const docs = await getDocs(Astro);
const viewDocs = docs.filter(doc => doc.showIn === 'pomozj-detyam');

const siteSeo = await getSiteSeo(Astro);
const seo = siteSeo.find(item => item.slug === 'pomozj-detyam');

const breadcrumbs = [
  {
    url: '/',
    name: 'Главная',
  },

  {
    url: '/programs/pomozj-detyam',
    name: 'Помощь детям',
  },
  {
    url: '/programs/pomozj-detyam/docs',
    name: 'Документы',
  },
];
---

<RootLayout>
  <Seo
    slot={'seo'}
    title={'Документы для подачи заявки'}
    description={seo?.description || ''}
    imageUrls={{ fb: seo?.image || '' }}
  />

  <main>
    <section class="py-8 xl:pb-20 xl:pt-5">
      <div class="container">
        <Breadcrumbs {breadcrumbs} />
        <SectHeading level={1} className="text-center md:mb-5">
          <SectHeadingAccent>Документы</SectHeadingAccent>
        </SectHeading>
        <p class="font-sov-mod xl:text-2xl text-center max-w-2xl mx-auto mb-16">
          ДЛЯ ПОДАЧИ ЗАЯВКИ ПО ПРОГРАММЕ «ПОМОЩЬ ТЯЖЕЛО БОЛЬНЫМ ДЕТЯМ»
        </p>
        <ViewDocs docs={viewDocs} />
      </div>
    </section>
  </main>
</RootLayout>

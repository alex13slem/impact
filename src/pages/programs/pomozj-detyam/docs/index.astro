---
import { RootLayout } from '@/components/layouts/root';
import { Seo } from '@/components/seo';
import SectHeading from '@/components/ui/sect-heading.svelte';
import { ViewDocs } from '@/components/view-docs';
import { docs } from '@/lib/data/docs';
import { siteSeo } from "@/lib/data/siteSeo";
import { ViewTransitions } from 'astro:transitions';

const seo = siteSeo.find((item) => item.slug === 'pomozj-detyam');

const viewDocs = docs.filter(doc => doc.showIn === 'pomozj-detyam');
---

<ViewTransitions  />
<RootLayout>
	<Seo
		slot={'seo'}
		title={(seo?.name || 'Помощь тяжелобольным детям') + ' · Документы для подачи заявки'}
		description={seo?.description || ''}
		imageUrls={{fb: seo?.image || ''}}
	/>

	<main>
    <section class="py-8 xl:py-20 overflow-clip">
      <div class="container">
        <SectHeading className='text-center md:mb-5 mb-3' level={1}>
          Документы
        </SectHeading>
        <p class="font-thin font-sov-mod uppercase text-sm md:text-lg lg:text-2xl text-center  mb-10">
          для подачи заявки по программе <br/>«{seo?.name || 'Помощь тяжелобольным детям'}»
        </p>
        <ViewDocs docs={viewDocs} />
      </div>
    </section>
	</main>
</RootLayout>

---
import phPhoto from '@/assets/img/ph-photo.webp';
import { GallerySlider } from "@/components/gallery-slider";
import { RootLayout } from "@/components/layouts/root";
import { Seo } from "@/components/seo";
import { wardsWithRelatedData } from "@/lib/data/wards";
import type { WpGallery } from "@/lib/schemas/wpGallery";
import { cn } from "@/lib/utils";
import { ViewTransitions } from 'astro:transitions';

// export const getStaticPaths = (() => {
//   const paths = wardsWithRelatedData.map(item => {
//     const sameCategoryWards = wardsWithRelatedData.filter(ward => ward.charityProgram.slug === item.charityProgram.slug);
//     const currentIndex = sameCategoryWards.indexOf(item);
//     const prevItem = sameCategoryWards[(currentIndex - 1 + sameCategoryWards.length) % sameCategoryWards.length];
//     const nextItem = sameCategoryWards[(currentIndex + 1) % sameCategoryWards.length];
//     const prevLink = `/programs/${prevItem.charityProgram.slug}/ward/${prevItem.id}`;
//     const nextLink = `/programs/${nextItem.charityProgram.slug}/ward/${nextItem.id}`;
//     return {
//       params: { id: item.id, category: item.charityProgram.slug },
//       props: { ward:item, prevLink, nextLink },
//     }
//   })
//   return paths;

// }) satisfies GetStaticPaths;
// const { ward, nextLink, prevLink } = Astro.props;


const { id: paramsId, category } = Astro.params;
const id = Number(paramsId);
if (isNaN(id)) return Astro.redirect("/404");
const ward = wardsWithRelatedData.find(item => item.id === id);
if (!ward) return Astro.redirect("/404");

const sameCategoryWards = wardsWithRelatedData.filter(ward => ward.charityProgram.slug === category);
const currentIndex = sameCategoryWards.indexOf(ward);
const prevItem = sameCategoryWards[(currentIndex - 1 + sameCategoryWards.length) % sameCategoryWards.length];
const nextItem = sameCategoryWards[(currentIndex + 1) % sameCategoryWards.length];
const prevLink = `/programs/${prevItem.charityProgram.slug}/ward/${prevItem.id}`;
const nextLink = `/programs/${nextItem.charityProgram.slug}/ward/${nextItem.id}`;


const photo = typeof ward.image === 'string' ? ward.image : phPhoto.src;
const gallery:WpGallery[] = [{src: photo, alt: ward.name}, ...(Array.isArray(ward.gallery) ? ward.gallery : [])];
---

<ViewTransitions  />

<RootLayout>
	<Seo
		slot={'seo'}
		title={ward.name}
		description={ward.description}
		imageUrls={{fb: photo }}
	/>

	<main>
    <section class="py-8 xl:py-20">
      <div class="container flex flex-col xl:flex-row gap-10 xl:gap-20">
        <div>
          <div class="relative w-fit mx-auto">
            <div class="absolute inset-y-5 -inset-x-7  bg-white/20 -z-10 rounded-3xl"></div>
            <GallerySlider {gallery} client:load/>
            {['prev', 'next'].map((dir) => (
              <button
                class={cn(
                  {
                    'prev-btn left-0 -translate-x-1/2 rotate-180': dir === 'prev',
                    'next-btn right-0 translate-x-1/2 ': dir === 'next',
                  },
                  'bg-dark absolute top-1/2 -translate-y-1/2 z-20  rounded-full  p-3 disabled:opacity-30 hover:bg-dark/80 transition-colors',
                )}
                slot="container-end"
              >
                <svg
                  width="1em"
                  height="1em"
                  viewBox="0 0 12.6865 9.69238"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                  xmlns:xlink="http://www.w3.org/1999/xlink"
                >
                  <path
                    d="M7.48 0.35L11.97 4.84L7.48 9.33M11.97 4.84L0 4.84"
                    stroke="currentColor"
                    stroke-opacity="1"
                    stroke-width="1"
                  />
                </svg>
              </button>
            ))}
          </div>
          {ward.desire && (
            <p class="mt-5 text-center xl:text-left">{ward.desire}</p>
          )}
          <div class="mt-5">
            <button
              class="relative border border-white rounded-xl py-3 px-5 leading-none font-thin flex gap-4 z-0"
            >
              <a href="/" class="absolute inset-0 opacity-0 z-10">/index</a>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="1em"
                height="1em"
                viewBox="0 0 16 16"
                ><path
                  fill="currentColor"
                  fill-rule="evenodd"
                  d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8"
                /></svg
              >
              На главную
            </button>
          </div>
        </div>
        <div class="flex-1">
          <div class="flex items-center justify-between gap-8 flex-col sm:flex-row">
            <div class="self-start sm:self-center">
              <p class="text-sm md:text-base font-thin">Подопечный Благотворительного фонда</p>
              <h1 class="font-sov-mod text-3xl md:text-5xl mt-2">{ward.name}</h1>
            </div>
            <nav class="flex gap-5 -order-1 sm:order-none self-start sm:self-center">
              {[prevLink, nextLink].map((link, index) => (
                <button class={cn(
                  {
                    "rotate-180": index === 0
                  },
                  "relative bg-white/80 hover:bg-white transition-colors text-dark w-12 h-12 flex items-center justify-center rounded-2xl")}>
                  <a href={link} class="absolute inset-0"></a>
                  <svg
                    width="1em"
                    height="1em"
                    viewBox="0 0 12.6865 9.69238"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                    xmlns:xlink="http://www.w3.org/1999/xlink"
                  >
                    <path
                      d="M7.48 0.35L11.97 4.84L7.48 9.33M11.97 4.84L0 4.84"
                      stroke="currentColor"
                      stroke-opacity="1"
                      stroke-width="1"
                    />
                  </svg>
                </button>
              ))}
            </nav>
          </div>

          <div class="prose mt-10" set:html={ward.detailDescription}/>
        </div>
      </div>
    </section>
	</main>
</RootLayout>

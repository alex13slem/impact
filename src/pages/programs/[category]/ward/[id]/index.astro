---
import phPhoto from '@/assets/img/ph-photo.webp';
import { GallerySlider } from '@/components/gallery-slider';
import { RootLayout } from '@/components/layouts/root';
import { Seo } from '@/components/seo';
import ButtonBack from '@/components/ui/button-back.svelte';
import { fetchWardsWithRelatedData } from '@/lib/data/wards';
import type { WpGallery } from '@/lib/schemas/wpGallery';
import { cn } from '@/lib/utils';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const wards = await fetchWardsWithRelatedData();
  const paths = wards.map(item => {
    const sameCategoryWards = wards.filter(
      ward => ward.charityProgram.slug === item.charityProgram.slug,
    );
    const currentIndex = sameCategoryWards.indexOf(item);
    const prevWard =
      sameCategoryWards[
        (currentIndex - 1 + sameCategoryWards.length) % sameCategoryWards.length
      ];
    const nextWard =
      sameCategoryWards[(currentIndex + 1) % sameCategoryWards.length];
    return {
      params: { id: item.id, category: item.charityProgram.slug },
      props: { ward: item, prevWard, nextWard },
    };
  });
  return paths;
}) satisfies GetStaticPaths;
const { ward, nextWard, prevWard } = Astro.props;

// const { id: paramsId, category } = Astro.params;
// const id = Number(paramsId);
// if (isNaN(id)) return Astro.redirect("/404");
// const wards = await getWards(Astro);
// const ward = wards.find(item => item.id === id);
// if (!ward) return Astro.redirect("/404");

// const sameCategoryWards = wards.filter(ward => ward.charityProgram.slug === category);
// const currentIndex = sameCategoryWards.indexOf(ward);
// const prevItem = sameCategoryWards[(currentIndex - 1 + sameCategoryWards.length) % sameCategoryWards.length];
// const nextItem = sameCategoryWards[(currentIndex + 1) % sameCategoryWards.length];
// const prevLink = `/programs/${prevItem.charityProgram.slug}/ward/${prevItem.id}`;
// const nextLink = `/programs/${nextItem.charityProgram.slug}/ward/${nextItem.id}`;

const photo = typeof ward.image === 'string' ? ward.image : phPhoto.src;
const gallery: WpGallery[] = [
  { src: photo, alt: ward.name },
  ...(Array.isArray(ward.gallery) ? ward.gallery : []),
];
---

<RootLayout>
  <!-- <ViewTransitions  slot={'head'}/> -->
  <Seo
    slot={'seo'}
    title={ward.name}
    description={ward.description}
    imageUrls={{ fb: photo }}
  />

  <main>
    <section class="pb-8 xl:pb-20">
      <div class="container flex flex-col xl:flex-row gap-10 xl:gap-20">
        <div>
          <div class="mb-5">
            <ButtonBack href="/"> На главную </ButtonBack>
          </div>
          <div class="relative w-fit mx-auto">
            <div
              class="absolute inset-y-5 -inset-x-7 bg-white/20 -z-10 rounded-3xl"
            >
            </div>
            <GallerySlider {gallery} client:load />
            {
              ['prev', 'next'].map(dir => (
                <button
                  class={cn(
                    {
                      'prev-btn left-0 -translate-x-1/2 rotate-180':
                        dir === 'prev',
                      'next-btn right-0 translate-x-1/2 ': dir === 'next',
                    },
                    'bg-dark absolute top-1/2 -translate-y-1/2 z-20  rounded-full  p-3 disabled:opacity-30 hover:bg-dark/80 transition-colors',
                  )}
                  slot="container-end"
                >
                  <svg
                    width="1em"
                    height="1em"
                    viewBox="0 0 12.6865 9.69238"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                    xmlns:xlink="http://www.w3.org/1999/xlink"
                  >
                    <path
                      d="M7.48 0.35L11.97 4.84L7.48 9.33M11.97 4.84L0 4.84"
                      stroke="currentColor"
                      stroke-opacity="1"
                      stroke-width="1"
                    />
                  </svg>
                </button>
              ))
            }
          </div>
          {
            ward.desire && (
              <p class="mt-5 text-center xl:text-left">{ward.desire}</p>
            )
          }
        </div>
        <div class="flex-1">
          <div
            class="flex items-center justify-between gap-8 flex-col sm:flex-row"
          >
            <div class="self-start sm:self-center">
              <p class="text-sm md:text-base font-thin">
                Подопечный Благотворительного фонда
              </p>
              <h1 class="font-sov-mod text-3xl md:text-5xl mt-2">
                {ward.name}
              </h1>
            </div>
            <nav class="flex gap-5 -order-1 sm:order-none justify-center">
              {
                [prevWard, nextWard].map((ward, index) => (
                  <div
                    class="flex-1 flex flex-col gap-2"
                    class:list={[{ 'items-end text-right': index === 0 }]}
                  >
                    <p class="text-xs max-w-32">{ward.name}</p>
                    <button
                      class={
                        'relative bg-white/80 hover:bg-white transition-colors text-dark w-12 h-12 flex items-center justify-center rounded-2xl'
                      }
                    >
                      <a
                        href={`/programs/${ward.charityProgram.slug}/ward/${ward.id}`}
                        class="absolute inset-0"
                      />
                      <svg
                        class:list={[
                          {
                            'rotate-180': index === 0,
                          },
                        ]}
                        width="1em"
                        height="1em"
                        viewBox="0 0 12.6865 9.69238"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                        xmlns:xlink="http://www.w3.org/1999/xlink"
                      >
                        <path
                          d="M7.48 0.35L11.97 4.84L7.48 9.33M11.97 4.84L0 4.84"
                          stroke="currentColor"
                          stroke-opacity="1"
                          stroke-width="1"
                        />
                      </svg>
                    </button>
                  </div>
                ))
              }
            </nav>
          </div>

          <div class="prose mt-10" set:html={ward.detailDescription} />
        </div>
      </div>
    </section>
  </main>
</RootLayout>

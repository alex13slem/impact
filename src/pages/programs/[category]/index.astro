---
import { RootLayout } from "@/components/layouts/root";
import { PartnerFormTrigger } from "@/components/partner-form-trigger";
import {
  ProgramInteractiveNews,
  ProgramInteractivePartners,
} from "@/components/sections/program-interactive";
import { Seo } from "@/components/seo";
import Breadcrumbs from "@/components/ui/breadcrumbs.astro";
import Button from "@/components/ui/button.svelte";
import IconDownload from "@/components/ui/icon-download.svelte";
import IconDocs from "@/components/ui/icons/icon-docs.svelte";
import SectHeadingAccent from "@/components/ui/sect-heading-accent.svelte";
import SectHeading from "@/components/ui/sect-heading.svelte";
import { WardsSlider } from "@/components/wards-slider";
import { fetchCharityPrograms } from "@/lib/data/charityPrograms";
import { fetchDocs } from "@/lib/data/docs";
import { fetchNewsWithRelatedData } from "@/lib/data/news";
import { fetchPartnersWithRelatedData } from "@/lib/data/partners";
import { fetchSiteSeo } from "@/lib/data/siteSeo";
import { fetchWardsWithRelatedData } from "@/lib/data/wards";
import type { GetStaticPaths } from "astro";

const PROGRAMS = {
  "помощь детям": "pomozj-detyam",
  "нежные руки": "nezhnie-ruki",
  "социальные лифты": "socialnye-lifty",
  "огонь жизни": "ogon-zhizni",
} as const;

export const getStaticPaths = (async () => {
  const programs = [...(await fetchCharityPrograms())].sort(
    (a, b) => a.order - b.order
  );
  const partners = await fetchPartnersWithRelatedData();
  const wards = await fetchWardsWithRelatedData();

  const news = await fetchNewsWithRelatedData();
  const docs = await fetchDocs();

  return programs.map((program) => {
    const programWards = wards.filter(
      (ward) => ward.charityProgramId === program.id
    );
    const programPartners = partners.filter(
      (partner) => partner.charityProgramId === program.id
    );
    const programNews = [...news].filter(
      (newsItem) => newsItem.charityProgramId === program.id
    );
    const hasDocs = docs.some((doc) => doc.showIn === program.slug);

    return {
      params: { category: program.slug },
      props: {
        program,
        hasDocs,
        partners: programPartners,
        wards: programWards,
        news: programNews,
      },
    };
  });
}) satisfies GetStaticPaths;

const { program, partners, wards, news, hasDocs } = Astro.props;

const siteSeo = await fetchSiteSeo();
const seo = siteSeo.find((item) => item.slug === program.slug);

const breadcrumbs = [
  {
    url: "/",
    name: "Главная",
  },
  {
    url: "/programs",
    name: "Программы",
  },
  {
    url: `/programs/${program.slug}`,
    name: program.name,
  },
];
---

<RootLayout>
  <Seo
    slot={"seo"}
    title={seo?.name || `Программа фонда «${program.name}»`}
    description={seo?.description || ""}
    imageUrls={{ fb: seo?.image || "" }}
  />

  <main>
    <section class="py-8 xl:pb-20 xl:pt-5">
      <div class="container">
        <Breadcrumbs {breadcrumbs} />
        <div class="flex justify-between items-start flex-wrap md:gap-4">
          <SectHeading
            className="max-w-xl mb-4 md:mb-4 text-balance flex-grow"
            level={1}
          >
            <SectHeadingAccent>{program.name}</SectHeadingAccent>
          </SectHeading>
          <div class="xl:flex-[0_0_50%] flex justify-end">
            <div
              class="flex flex-col gap-4 xl:order-none order-1 mt-4 xl:mt-0 w-full lg:w-auto max-w-96"
            >
              {
                program.slug === PROGRAMS["социальные лифты"] && (
                  <PartnerFormTrigger className="w-full" client:load>
                    Стать партнёром
                  </PartnerFormTrigger>
                )
              }
              {
                hasDocs && (
                  <Button
                    variant="accent"
                    href={`/programs/${program.slug}/docs`}
                  >
                    <IconDocs class="text-2xl text-dark" /> Документы для подачи
                    заявки
                  </Button>
                )
              }
              {
                program.presentation && (
                  <Button
                    variant="outline"
                    className=" hover:text-accent transition-colors"
                    external
                    href={program.presentation.toString()}
                  >
                    <IconDownload class="text-2xl text-accent" /> Скачать
                    программу
                  </Button>
                )
              }
            </div>
          </div>
          <div
            class="flex-grow text-sm font-thin md:text-base max-w-3xl"
            set:html={program.description}
          />
        </div>

        {
          program.slug === PROGRAMS["огонь жизни"] && (
            <div class="flex mt-14 flex-col lg:flex-row gap-10 lg:gap-20 xl:gap-40">
              <div class="flex-1">
                <img
                  src={program.image}
                  alt={program.name}
                  class="w-full aspect-[4/3] object-cover object-center rounded-3xl"
                />
              </div>
              <div class="flex-1 grid gap-3 lg:gap-5 content-start text-base lg:text-xl">
                <h3 class="text-xl md:text-2xl font-bold">
                  Мы стремимся изменить отношение общества к донорству костного
                  мозга
                </h3>
                <p class="max-w-[500px] ">
                  <>
                    <b>• Привлечь внимание</b>
                    <br />
                  </>
                  Мы хотим, чтобы каждый задумался о важности донорства костного
                  мозга.
                </p>
                <p class="max-w-[500px] ">
                  <>
                    <b>• Повышение осведомленности</b>
                    <br />
                  </>
                  Наша задача - развеять мифы и предоставить достоверную
                  информацию о донорстве костного мозга.
                </p>
                <p class="max-w-[500px] ">
                  <>
                    <b>• Объединение людей</b>
                    <br />
                  </>
                  Мы создаем сообщество неравнодушных людей, готовых помогать
                  другим.
                </p>
              </div>
            </div>
          )
        }

        {
          program.slug === PROGRAMS["огонь жизни"] && news.length && (
            <div class="mt-14 grid lg:grid-cols-2">
              {news
                .filter(
                  (n) =>
                    !n.draft &&
                    new Date(n.date).getDate() >= new Date().getDate()
                )
                .slice(0, 10)
                .reverse()
                .map((item) => {
                  const time =
                    item.description &&
                    item.description
                      ?.split("Время начала: ")
                      .at(1)
                      ?.slice(0, 5);
                  return (
                    <article class="relative border-s border-white/90 py-4 px-5 md:px-10 lg:pr-24">
                      {item.body && (
                        <a
                          href={`/news/${item.slug}`}
                          class="absolute inset-0"
                        />
                      )}
                      <header class="pb-2 flex items-center justify-between border-b border-white/15">
                        <time
                          datetime={new Date(item.date).toISOString()}
                          class="text-4xl font-sov-mod uppercase"
                        >
                          <SectHeadingAccent>
                            {new Date(item.date).toLocaleDateString("ru-RU", {
                              month: "numeric",
                              day: "numeric",
                            })}
                          </SectHeadingAccent>
                        </time>

                        {time && <time datetime={time}>{time}</time>}
                      </header>
                      <h3 class="mt-2 text-2xl">{item.title}</h3>
                      {item.description && (
                        <p class="mt-2 line-clamp-3 text-ellipsis">
                          {item.description}
                        </p>
                      )}
                    </article>
                  );
                })}
            </div>
          )
        }

        {
          !!wards.length && (
            <>
              <SectHeading className="!text-4xl !mt-16 !mb-8 ">
                Наши <SectHeadingAccent>подопечные</SectHeadingAccent>
              </SectHeading>
              <WardsSlider {wards} client:load />
            </>
          )
        }

        {
          program.slug !== PROGRAMS["огонь жизни"] && (
            <ProgramInteractivePartners {partners} {program} client:load />
          )
        }

        {
          program.slug !== PROGRAMS["огонь жизни"] && (
            <ProgramInteractiveNews
              className="mt-28"
              {news}
              program={program.slug}
              client:load
            />
          )
        }
      </div>
    </section>
  </main>
</RootLayout>

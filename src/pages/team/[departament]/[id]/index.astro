---
import { RootLayout } from "@/components/layouts/root";
import { Seo } from "@/components/seo";
import { staffs } from "@/lib/data/staffs";
import { staffsPositions } from "@/lib/data/staffsPositions";
import { cn } from "@/lib/utils";
import type { GetStaticPaths } from "astro";
import { ViewTransitions } from 'astro:transitions';
//@ts-ignore
import { convert } from 'html-to-text';

export const getStaticPaths = (() => {
  const paths = staffs.map(item => {
    const sameDepartamentStaffs = staffs.filter(staff => staff.staffPositions[0] === item.staffPositions[0]);
    const departament = staffsPositions.find(pos => pos.id === item.staffPositions[0])!;
    const currentIndex = sameDepartamentStaffs.indexOf(item);
    const prevItem = sameDepartamentStaffs[(currentIndex - 1 + sameDepartamentStaffs.length) % sameDepartamentStaffs.length];
    const nextItem = sameDepartamentStaffs[(currentIndex + 1) % sameDepartamentStaffs.length];
    const prevLink = `/team/${prevItem.staffPositions[0]}/${prevItem.id}`;
    const nextLink = `/team/${nextItem.staffPositions[0]}/${nextItem.id}`;
    return {
      params: { id: item.id, departament: item.staffPositions[0] },
      props: { staff:item, prevLink, nextLink, departament },
    }
  })
  return paths;

}) satisfies GetStaticPaths;

const { staff, nextLink, prevLink, departament } = Astro.props;

---

<ViewTransitions  />

<RootLayout>
	<Seo
		slot={'seo'}
		title={staff.name}
		description={convert(staff.description)}
		imageUrls={{fb: staff.image || ''}}
	/>

	<main>
    <section class="py-8 xl:py-20">
      <div class="container flex flex-col xl:flex-row gap-10 xl:gap-20">
        <div>
          <div class="relative w-fit mx-auto">
            <img class="max-w-lg w-full aspect-square object-cover object-center rounded-3xl" src={staff.image} alt={staff.name}>
          </div>
          <div class="mt-5">
            <button
              class="relative border border-white rounded-xl py-3 px-5 leading-none font-thin flex gap-4"
            >
              <a href="/" class="absolute inset-0 opacity-0">/index</a>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="1em"
                height="1em"
                viewBox="0 0 16 16"
                ><path
                  fill="currentColor"
                  fill-rule="evenodd"
                  d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8"
                /></svg
              >
              На главную
            </button>
          </div>
        </div>
        <div class="flex-1">
          <div class="flex items-center justify-between gap-8 flex-col sm:flex-row">
            <div class="self-start sm:self-center">
              <p class="text-sm md:text-base font-thin">{departament.name}</p>
              <h1 class="font-sov-mod text-3xl md:text-5xl">{staff.name}</h1>
            </div>
            <nav class="flex gap-5 -order-1 sm:order-none self-start sm:self-center">
              {[prevLink, nextLink].map((link, index) => (
                <button class={cn(
                  {
                    "rotate-180": index === 0
                  },
                  "relative bg-white/80 hover:bg-white transition-colors text-dark w-12 h-12 flex items-center justify-center rounded-2xl")}>
                  <a href={link} class="absolute inset-0"></a>
                  <svg
                    width="1em"
                    height="1em"
                    viewBox="0 0 12.6865 9.69238"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                    xmlns:xlink="http://www.w3.org/1999/xlink"
                  >
                    <path
                      d="M7.48 0.35L11.97 4.84L7.48 9.33M11.97 4.84L0 4.84"
                      stroke="currentColor"
                      stroke-opacity="1"
                      stroke-width="1"
                    />
                  </svg>
                </button>
              ))}
            </nav>
          </div>

          <div class="prose mt-10" set:html={staff.description}/>
        </div>
      </div>
    </section>
	</main>
</RootLayout>

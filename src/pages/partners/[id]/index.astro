---
<RootLayout>
	<ViewTransitions  slot={'head'} />
	<Seo
		slot={'seo'}
		title={partner.name}
		description={partner.description}
		imageUrls={{fb: partner.image || ''}}
	/>
	<main>
    <SectPartner {partner} />
	</main>
</RootLayout>

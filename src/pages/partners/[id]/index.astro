---
import ogImage from "@/assets/img/og.webp";
import { RootLayout } from "@/components/layouts/root";
import { SectPartner } from "@/components/sections/partner-page";
import SectBreadcrumbs from "@/components/sections/sect-breadcrumbs.astro";
import { Seo } from "@/components/seo";
import { fetchPartnersWithRelatedData } from "@/lib/data/partners";
import type { GetStaticPaths } from "astro";

// const { id: paramsId } = Astro.params;
// const id = Number(paramsId);
// if (isNaN(id)) return Astro.redirect("/404");
// const partners = (await fetchPartnersWithRelatedData()).filter(p => !!p.events.length);
// const partner = partners.filter(p => !!p.events?.length).find(p => p.id === id);
// if (!partner) return Astro.redirect("/404");

export const getStaticPaths = (async () => {
  const partners = await fetchPartnersWithRelatedData();

  return (
    partners
      // .filter(p => !!p.events.length)
      .map((partner) => {
        return {
          params: {
            id: partner.id,
          },
          props: {
            partner,
          },
        };
      })
  );
}) satisfies GetStaticPaths;
const { partner } = Astro.props;

const breadcrumbs = [
  {
    name: "Главная",
    url: "/",
  },

  {
    name: partner.name,
    url: `/partners/${partner.id}`,
  },
];
---

<RootLayout>
  <Seo
    slot={"seo"}
    title={partner.name}
    description={partner.description}
    imageUrls={{ fb: partner.image ? partner.image.toString() : ogImage.src }}
  />
  <main class="py-[1px]">
    <SectBreadcrumbs {breadcrumbs} />
    <SectPartner {partner} />
  </main>
</RootLayout>

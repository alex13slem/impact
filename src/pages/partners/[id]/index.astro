---
import { RootLayout } from "@/components/layouts/root";
import { SectPartner } from "@/components/sections/partner-page";
import { Seo } from "@/components/seo";
import { fetchPartnersWithRelatedData } from "@/lib/data/partners";
import type { GetStaticPaths } from "astro";
import { ViewTransitions } from 'astro:transitions';

// const { id: paramsId } = Astro.params;
// const id = Number(paramsId);
// if (isNaN(id)) return Astro.redirect("/404");
// const partners = (await fetchPartnersWithRelatedData()).filter(p => !!p.events.length);
// const partner = partners.filter(p => !!p.events?.length).find(p => p.id === id);
// if (!partner) return Astro.redirect("/404");

export const getStaticPaths = ( async () => {
	const partners = (await fetchPartnersWithRelatedData()).filter(p => !!p.events.length);

  const paths = partners
    .filter(p => !!p.events.length)
    .map( (partner) => {
    return {
      params: {
        id: partner.id
      },
      props: {
        partner
      }
    }
  });
  return paths;
}) satisfies GetStaticPaths;
const { partner } = Astro.props



---
<RootLayout>
	<ViewTransitions  slot={'head'} />
	<Seo
		slot={'seo'}
		title={partner.name}
		description={partner.description}
		imageUrls={{fb: partner.image.toString()}}
	/>
	<main>
    <SectPartner {partner} />
	</main>
</RootLayout>

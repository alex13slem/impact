---
import { RootLayout } from '@/components/layouts/root';
import { Seo } from '@/components/seo';
import Breadcrumbs from '@/components/ui/breadcrumbs.astro';
import SectHeadingAccent from '@/components/ui/sect-heading-accent.svelte';
import SectHeading from '@/components/ui/sect-heading.svelte';
import { fetchThanks } from '@/lib/data/thanks';

const thanks = await fetchThanks();
const breadcrumbs = [
  { name: 'Главная', url: '/' },
  { name: 'Благодарности', url: '/thanks' },
];
---

<RootLayout>
  <Seo
    slot={'seo'}
    title={'Благодарности'}
    description={'Благодарности благотворительному фонда Impact'}
    imageUrls={{ fb: '' }}
  />

  <main>
    <section class="pb-8 xl:pb-20">
      <div class="container">
        <Breadcrumbs {breadcrumbs} />
        <SectHeading className="text-center" level={1}>
          <SectHeadingAccent>Благодарности</SectHeadingAccent>
        </SectHeading>
        <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
          {
            thanks.map(thank => (
              <article class="border border-white/90 hover:border-accent transition-colors p-6 pb-11 rounded-3xl">
                <div class="bg-white/90 rounded-2xl overflow-clip">
                  <img
                    class="aspect-[4/3] w-full object-cover object-center"
                    src={thank.image}
                    alt={thank.title}
                  />
                </div>
                <h2 class="p-3 rounded-full bg-gradient-to-br from-gr-start via-gr-middle to-gr-end text-dark mt-10 max-w-64 w-full text-center uppercase ">
                  {thank.title}
                </h2>
                <p class="text-sm mt-5">{thank.description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>
  </main>
</RootLayout>

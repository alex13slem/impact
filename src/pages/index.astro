---
import { SectCharityPrograms } from '@/components/sections/charity-programs';
import { SectContacts } from '@/components/sections/contacts';
import { SectDescription } from '@/components/sections/description';
import { SectDocuments } from '@/components/sections/documents';
import { SectHero } from '@/components/sections/hero';
import { SectOurMission } from '@/components/sections/our-mission';
import { SectOurPartners } from '@/components/sections/our-partners';
import { SectOurStuff } from '@/components/sections/our-staff';
import { SectPay } from '@/components/sections/pay';
import { goals } from '@/lib/data/goals';
import { RootLayout } from '../components/layouts/root';
import { Seo } from '../components/seo';

import { SectOurGoals } from '@/components/sections/our-goals';
import { siteSeo } from "@/lib/data/siteSeo";


const seo = siteSeo.find((item) => item.slug === 'home');
---

<RootLayout>
	<Seo
		slot={'seo'}
		title={seo?.name || 'Главная'}
		description={seo?.description || ''}
		imageUrls={{fb: seo?.image || ''}}
	/>

	<main >
		<SectHero />
		<SectDescription />
		<SectOurMission />
		<SectCharityPrograms />
		<SectOurPartners />
		<SectOurStuff />
		{ goals.map((goal) => <SectOurGoals {goal} />) }
		<SectPay />
		<SectDocuments />
		<SectContacts />
	</main>
</RootLayout>

---
import { RootLayout } from '@/components/layouts/root';
import { SectNews } from '@/components/sections/news-page';
import { Seo } from '@/components/seo';
import Breadcrumbs from '@/components/ui/breadcrumbs.astro';
import { getSiteSeo } from '@/lib/data/siteSeo';

const siteSeo = await getSiteSeo(Astro);
const seo = siteSeo.find(item => item.slug === 'news');

const breadcrumbs = [
  { name: 'Главная', url: '/' },
  { name: 'Новости', url: '/news' },
];
---

<RootLayout>
  <Seo
    slot={'seo'}
    title={seo?.name || 'Новости'}
    description={seo?.description || ''}
    imageUrls={{ fb: seo?.image || '' }}
  />

  <main>
    <div class="container">
      <Breadcrumbs {breadcrumbs} />
    </div>
    <SectNews />
  </main>
</RootLayout>

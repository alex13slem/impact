---
import { RootLayout } from '@/components/layouts/root';
import { SectLastNews } from '@/components/sections/last-news';
import { SectNewsDetail } from '@/components/sections/news-detail';
import { Seo } from '@/components/seo';
import { newsWithRelated } from '@/lib/data/news';
import { ViewTransitions } from 'astro:transitions';

// export const getStaticPaths = (() => {
//   const paths = newsWithRelated.map((item) => ({
//     params: { slug: item.slug },
//     props: { item },
//   }))

//   return paths
// }) satisfies GetStaticPaths;

// const { item } = Astro.props

const { slug } = Astro.params;
const item = newsWithRelated.find((i) => i.slug === slug);
if (!item) return Astro.redirect("/404");

---
<ViewTransitions  />
<RootLayout>
	<Seo
		slot={'seo'}
		title={item.title}
		description={item.description}
		imageUrls={{fb: item.image || ''}}
	/>
	<main>
    <SectNewsDetail {item} />
    <SectLastNews />
	</main>
</RootLayout>

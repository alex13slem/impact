---
import { RootLayout } from '@/components/layouts/root';
import { SectLastNews } from '@/components/sections/last-news';
import { SectNewsDetail } from '@/components/sections/news-detail';
import { Seo } from '@/components/seo';
import { getNews } from '@/lib/data/news';
import { ViewTransitions } from 'astro:transitions';

const { slug } = Astro.params;
const news = await getNews(Astro);

const item = news.find(item => item.slug === slug);
if (!item) return Astro.redirect("/404");


// export const getStaticPaths = (() => {
//   const paths = newsWithRelated.map((item) => ({
//     params: { slug: item.slug },
//     props: { item },
//   }))

//   return paths
// }) satisfies GetStaticPaths;

// const { item } = Astro.props


---
<ViewTransitions  />
<RootLayout>
	<Seo
		slot={'seo'}
		title={item.title}
		description={item.description}
		imageUrls={{fb: item.image || ''}}
	/>
	<main>
    <SectNewsDetail {item} />
    <SectLastNews {news}/>
	</main>
</RootLayout>

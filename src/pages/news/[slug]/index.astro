---
import { RootLayout } from "@/components/layouts/root";
import { SectLastNews } from "@/components/sections/last-news";
import { SectNewsDetail } from "@/components/sections/news-detail";
import SectBreadcrumbs from "@/components/sections/sect-breadcrumbs.astro";
import { Seo } from "@/components/seo";
import { fetchNewsWithRelatedData } from "@/lib/data/news";
import type { GetStaticPaths } from "astro";

// const { slug } = Astro.params;
// const news = await getNews(Astro);

// const item = news.find(item => item.slug === slug);
// if (!item) return Astro.redirect("/404");

export const getStaticPaths = (async () => {
  // const news = (await fetchNews()).filter(n => !n.draft);
  // const newsWithRelations = await Promise.all(
  //   news.map(fetchRelatedDataForNews),
  // );

  const newsWithRelations = (await fetchNewsWithRelatedData()).filter(
    (n) => !n.draft && !!n.body
  );
  const paths = newsWithRelations.map((item) => {
    const currentPartnerNews = newsWithRelations
      .filter(
        (n) =>
          n.partnerId === item.partnerId &&
          n.slug !== item.slug &&
          !n.draft &&
          !!n.body
      )
      .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
    return {
      params: { slug: item.slug },
      props: { item, news: currentPartnerNews },
    };
  });

  return paths;
}) satisfies GetStaticPaths;

const { item, news } = Astro.props;

const breadcrumbs = [
  { name: "Главная", url: "/" },
  { name: "Новости", url: "/news" },
  { name: item.title, url: `/news/${item.slug}` },
];
---

<RootLayout>
  <Seo
    slot={"seo"}
    title={item.title}
    description={item.description ? item.description : undefined}
    imageUrls={{ fb: item.image || "" }}
  />
  <main class="py-[1px]">
    <SectBreadcrumbs {breadcrumbs} />

    <SectNewsDetail {item} />
    {news.length > 0 && <SectLastNews {news} />}
  </main>
</RootLayout>

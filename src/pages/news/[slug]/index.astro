//     params: { slug: item.slug },
//     props: { item },
//   }))

//   return paths
// }) satisfies GetStaticPaths;

// const { item } = Astro.props


---
<ViewTransitions  />
<RootLayout>
	<Seo
		slot={'seo'}
		title={item.title}
		description={item.description}
		imageUrls={{fb: item.image || ''}}
	/>
	<main>
    <SectNewsDetail {item} />
    <SectLastNews />
	</main>
</RootLayout>

---
import { RootLayout } from '@/components/layouts/root';
import { SectLastNews } from '@/components/sections/last-news';
import { SectNewsDetail } from '@/components/sections/news-detail';
import { Seo } from '@/components/seo';
import { news } from '@/lib/data/news';

export function getStaticPaths() {
  const paths = news.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }))

  return paths
}

const { item } = Astro.props


---

<RootLayout>
	<Seo
		slot={'seo'}
		title={item.title}
		description={item.description}
		imageUrls={{fb: item.image || ''}}
	/>
	<main>
    <SectNewsDetail item={item} />
    <SectLastNews />
	</main>
</RootLayout>

---
import { RootLayout } from '@/components/layouts/root';
import { SectLastNews } from '@/components/sections/last-news';
import { SectNewsDetail } from '@/components/sections/news-detail';
import { Seo } from '@/components/seo';
import { fetchNews, fetchRelatedDataForNews } from '@/lib/data/news';
import type { GetStaticPaths } from 'astro';
import { ViewTransitions } from 'astro:transitions';

// const { slug } = Astro.params;
// const news = await getNews(Astro);

// const item = news.find(item => item.slug === slug);
// if (!item) return Astro.redirect("/404");


export const getStaticPaths = ( async () => {
	const news = (await fetchNews()).filter(n => !n.draft)
	const newsWithRelations = await Promise.all(news.map(fetchRelatedDataForNews));
  const paths = newsWithRelations.map((item) => ({
    params: { slug: item.slug },
    props: { item, news: newsWithRelations },
  }))

  return paths
}) satisfies GetStaticPaths;

const { item , news} = Astro.props


---
<RootLayout>
	<ViewTransitions  slot={'head'} />
	<Seo
		slot={'seo'}
		title={item.title}
		description={item.description}
		imageUrls={{fb: item.image || ''}}
	/>
	<main>
    <SectNewsDetail {item} />
    <SectLastNews {news}/>
	</main>
</RootLayout>

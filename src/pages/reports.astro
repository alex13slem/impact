---
import logo from "@/assets/img/logo.svg";
import { RootLayout } from "@/components/layouts/root";
import SectBreadcrumbs from "@/components/sections/sect-breadcrumbs.astro";
import { Seo } from "@/components/seo";
import SectHeadingAccent from "@/components/ui/sect-heading-accent.svelte";
import SectHeading from "@/components/ui/sect-heading.svelte";
import { ViewDocs } from "@/components/view-docs";
import { fetchDocs } from "@/lib/data/docs";
import { Image } from "astro:assets";

const docs = await fetchDocs();
const viewDocs = docs.filter((doc) => doc.showIn === "reports");

const breadcrumbs = [
  { name: "Главная", url: "/" },
  { name: "Отчёты", url: "/reports" },
];
---

<RootLayout>
  <Seo
    slot={"seo"}
    title={"Отчёты"}
    description={"Отчёты благотворительного фонда Impact"}
    imageUrls={{ fb: "" }}
  />

  <main class="py-[1px]">
    <SectBreadcrumbs {breadcrumbs} />
    <section class="mt-8 xl:mb-20">
      <div class="container">
        <SectHeading className="text-center" level={1}>
          <SectHeadingAccent>Отчёты</SectHeadingAccent>
        </SectHeading>

        {
          !!viewDocs.length ? (
            <ViewDocs docs={viewDocs} />
          ) : (
            <div class="flex flex-col items-center gap-4 mt-20">
              <div class="p-8 rounded-full border border-accent inline-flex justify-center items-center aspect-square">
                <Image class={"aspect-square h-32"} src={logo} alt={"Impact"} />
              </div>
              <p class="max-w-60 text-center text-3xl mt-5">
                Нет актуальных отчетов
              </p>
            </div>
          )
        }
      </div>
    </section>
  </main>
</RootLayout>

---
import docImg from '@/assets/img/icon-pdf.svg';
import type { Docs } from '@/lib/schemas/data/docsSchema';
import { cn } from '@/lib/utils';
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'div'> {
  docs: Docs[];
}

const { docs, class: className, ...props } = Astro.props;
---

<div
  class={cn('grid md:grid-cols-2 xl:grid-cols-4 gap-4', className)}
  {...props}
>
  {
    docs
      .sort((a, b) => (a.order || 0) - (b.order || 0))
      .map(doc => (
        <article class="flex-grow relative p-8 xl:pt-14 flex gap-5 items-center lg:items-stretch lg:gap-20 lg:flex-col lg:justify-between border border-white/50 rounded-3xl lg:aspect-square">
          <a href={doc.link} target="_blank" class="absolute inset-0" />

          <img
            class="object-center w-9 md:w-16 lg:w-28 lg:mx-auto aspect-[3/4]"
            loading="lazy"
            src={typeof doc.image === 'string' ? doc.image : docImg.src}
            alt={doc.name}
          />
          <h3 class="text-lg md:text-xl lg:min-h-20">{doc.name}</h3>
        </article>
      ))
  }
</div>

---
import SectHeading from '@/components/ui/sect-heading.svelte';
import { charityPrograms } from '@/lib/data/charityPrograms';
import axios from 'axios';
import CategorySelect from './interactive-block/category-select.svelte';
import InteractiveNews from './interactive-block/index.svelte';

const news = await axios.get('/api/news', {baseURL:Astro.url.origin,
  headers: {
    Accept: 'application/json',
    'Cache-Control': 'no-store, no-cache, must-revalidate, proxy-revalidate',
    Pragma: 'no-cache',
    Expires: '0',
    'Surrogate-Control': 'no-store',
  }
}).then(res => res.data);
---

<section class="py-6 xl:py-20">
  <div class="container relative z-0">
    <SectHeading className='text-center hidden xl:block' level={1}>Новости</SectHeading>
    <CategorySelect {charityPrograms} client:load className="w-full sticky top-20 md:top-24 lg:top-28 xl:hidden mb-8 z-10" />
    <InteractiveNews  {charityPrograms} {news} client:load/>
  </div>
</section>

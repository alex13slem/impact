---
import Button from '@/components/ui/button.svelte'
import SvgHandHeart from '@/components/ui/svg-hand-heart.svelte'
import SvgPrayer from '@/components/ui/svg-prayer.svelte'
import type { SocialProgram } from '@/lib/data/social-programs'
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'article'> {
  program: SocialProgram
}

const { program, ...props } = Astro.props

const cnIcon = 'bg-white rounded-2xl text-dark flex justify-center items-center absolute w-16 h-16 text-4xl right-3 bottom-3'
---

<article {...props}>
  <div class="mb-6 rounded-3xl overflow-clip relative">
    <img src={program.image} alt={program.name}>
    {
      program.slug === 'nezhnie-ruki' &&  (
        <div class={cnIcon}>
          <SvgPrayer />
        </div>
      ) ||
      program.slug === 'socialnye-lifty' && (
        <div></div>
      ) ||
      program.slug === 'pomozj-detyam' && (
        <div class={cnIcon}>
          <SvgHandHeart />
        </div>
      ) || ''
    }
  </div>

  <h3 class="text-3xl font-medium mb-5 h-28 xl:h-20 2xl:h-auto">{program.name}</h3>

  <div class="lg:text-lg font-light mb-14 lg:leading-snug  h-56 xl:h-44 2xl:h-40 overflow-clip" >
    <Fragment set:html={program.description} />
  </div>

  <Button variant='dark' href={'/programs/' + program.slug}>
    Узнать подробнее
  </Button>

</article>

---
import bgSource from '@/assets/img/sect-2-bg.jpg';
import SectHeadingAccent from '@/components/ui/sect-heading-accent.svelte';
import SectHeading from '@/components/ui/sect-heading.svelte';
import { getImage } from 'astro:assets';

const bg = await getImage({ src: bgSource });
---

<section
  id="description"
  style={`background-image: url(${bg.src});`}
  class="relative z-0 bg-center bg-cover overflow-clip"
>
  <div class="absolute inset-0 bg-[#042A47A1] -z-10"></div>
  <div
    class="container py-32 md:h-svh flex flex-col justify-center items-center"
  >
    <SectHeading className="text-center">
      БЛАГОТВОРИТЕЛЬНЫЙ <br /> ФОНД <SectHeadingAccent>IMPACT</SectHeadingAccent
      >
    </SectHeading>
    <p
      class="text-balance hidden-block dir-bottom text-center max-w-xs md:max-w-2xl mx-auto prose"
    >
      Мы реализуем на территории Российской Федерации программы поддержки
      детей-сирот и детей, оставшихся без попечения родителей и находящихся в
      трудной жизненной ситуации, а также помогаем тяжелобольным детям в лечении
      и реабилитации.
    </p>
  </div>
</section>

---
import SectHeading from "@/components/ui/sect-heading.svelte";
import { partnersWithRelatedData } from "@/lib/data/partners";
import Slider from "./slider.svelte";


---

<section id="our-partners" class="our-partners bg-white text-dark py-8 lg:py-20 overflow-clip">
  <div class="container">
    <SectHeading className="text-center">Наши партнеры</SectHeading>
    <p class="hidden-block dir-right text-sm md:text-base lg:text-lg text-center max-w-2xl mx-auto mb-8 md:mb-10 lg:mb-16">
      Мы сотрудничаем с медицинскими организациями, учебными
      и детскими учреждениями, а также российскими компаниями, которые разделяют наши цели и оказывают поддержку в их достижении.
    </p>
  </div>
  <Slider partners={partnersWithRelatedData} client:load />
</section>

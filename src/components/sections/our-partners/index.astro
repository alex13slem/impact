---
import SectHeadingAccent from '@/components/ui/sect-heading-accent.svelte';
import SectHeading from '@/components/ui/sect-heading.svelte';
import { fetchPartnersWithRelatedData } from '@/lib/data/partners';
import Slider from './slider.svelte';

const partners = await fetchPartnersWithRelatedData();
---

<section id="our-partners" class="our-partners py-8 lg:py-20 overflow-clip">
  <div class="container">
    <SectHeading className="text-center"
      >Наши <SectHeadingAccent>партнеры</SectHeadingAccent></SectHeading
    >
    <p
      class="hidden-block dir-bottom prose text-center max-w-2xl mx-auto mb-8 md:mb-10 lg:mb-16"
    >
      Мы сотрудничаем с медицинскими организациями, учебными и детскими
      учреждениями, а также российскими компаниями, которые разделяют наши цели
      и оказывают поддержку в их достижении.
    </p>
  </div>
  <Slider {partners} client:load />
</section>

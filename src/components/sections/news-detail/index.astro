---
import { GallerySlider } from '@/components/gallery-slider';
import SectHeading from '@/components/ui/sect-heading.svelte';
import type { NewsItemWithRelated } from '@/lib/data/news';
import type { WpGallery } from '@/lib/schemas/wpGallery';
import { cn } from '@/lib/utils';

interface Props {
  item: NewsItemWithRelated
}

const { item } = Astro.props
const gallery:WpGallery[] = [{src: item.image, alt: item.title}, ...(Array.isArray(item.gallery) ? item.gallery : [])];
---

<section class="py-8 md:py-20">
  <div class="container relative z-0">
    <SectHeading className='' level={1} >
      {item.title}
    </SectHeading>
    <div class={'xl:flex gap-8 xl:gap-10 justify-center'}>

      <div class={'flex flex-col flex-1 self-start  mb-8'}>

        <div class="relative w-fit mx-auto">
          <div class="absolute inset-y-5 -inset-x-7  bg-white/20 -z-10 rounded-3xl"></div>
          <GallerySlider {gallery} client:load/>
          {['prev', 'next'].map((dir) => (
            <button
              class={cn(
                {
                  'prev-btn left-0 -translate-x-1/2 rotate-180': dir === 'prev',
                  'next-btn right-0 translate-x-1/2 ': dir === 'next',
                },
                'bg-dark absolute top-1/2 -translate-y-1/2 z-20  rounded-full  p-3 disabled:opacity-30 hover:bg-dark/80 transition-colors',
              )}
              slot="container-end"
            >
              <svg
                width="1em"
                height="1em"
                viewBox="0 0 12.6865 9.69238"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
                xmlns:xlink="http://www.w3.org/1999/xlink"
              >
                <path
                  d="M7.48 0.35L11.97 4.84L7.48 9.33M11.97 4.84L0 4.84"
                  stroke="currentColor"
                  stroke-opacity="1"
                  stroke-width="1"
                />
              </svg>
            </button>
          ))}
        </div>

        <div class="flex gap-4 mt-5">
          <button
            class="relative border border-white rounded-xl py-3 px-5 leading-none font-thin flex gap-4"
          >
            <a href="/news" class="absolute inset-0 opacity-0">/index</a>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="1em"
              height="1em"
              viewBox="0 0 16 16"
              ><path
                fill="currentColor"
                fill-rule="evenodd"
                d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8"
              /></svg
            >
            Все новости
          </button>
        </div>
      </div>

      <div class={ 'xl:max-w-3xl w-full prose'} set:html={item.body} />
    </div>
  </div>
</section>

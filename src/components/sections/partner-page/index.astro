---
import SectHeading from '@/components/ui/sect-heading.svelte'
import type { PartnerWithRelations } from '@/lib/schemas/data/partnersSchema'
import InteractiveBlock from './interactive-block/index.svelte'

interface Props {
  partner: PartnerWithRelations
}

const { partner } = Astro.props
---

<section class="py-8 xl:py-20">
  <div class="container">
    <SectHeading className=' mb-4 md:mb-4' level={1}>
      {partner.name}
    </SectHeading>
    <div class="mt-4 max-w-3xl prose" set:html={partner.description}></div>
    <div
      class={'xl:hidden bg-white bg-opacity-60 aspect-video rounded-3xl overflow-clip my-5 p-5'}
    >
    <img
      src={partner.image}
      class="w-full h-full object-contain object-center "
      alt=""
    />
    </div>
    <InteractiveBlock className='mt-8' client:load {partner} />
  </div>
</section>

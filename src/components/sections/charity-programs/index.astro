---
import SectHeading from "@/components/ui/sect-heading.svelte";
import { charityPrograms } from "@/lib/data/charityPrograms";
import DesktopCard from "./desktop-card.astro";
import Slider from "./slider.svelte";

---

<section id="social-programs" class="social-programs bg-white text-dark py-8 md:py-20 overflow-clip">
  <div class="container">
    <SectHeading className="text-center">Наши программы</SectHeading>
    <div class="hidden grid-cols-3 gap-5 lg:grid">
      {
        charityPrograms.map((program, idx) => (
          <DesktopCard {program} style={`transition-delay: ${idx * 500}ms`} class={'hidden-block dir-bottom'}/>
        ))
      }
    </div>

    <Slider {charityPrograms} client:load className="lg:hidden" />
  </div>
</section>

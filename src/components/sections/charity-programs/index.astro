---
import Button from '@/components/ui/button.svelte';
import SectHeading from '@/components/ui/sect-heading.svelte';
import type { CharityProgram } from '@/lib/schemas/data/charityProgramsSchema';
interface Props {
  charityPrograms: CharityProgram[];
}

const { charityPrograms } = Astro.props;
---

<section
  id="social-programs"
  class="social-programs text-dark overflow-clip relative z-10"
>
  <div class="container relative py-8 md:py-20 pr-8">
    <div class="absolute right-4 top-0 w-[150%] h-[100%] bg-[#FDFBF7] -z-10">
    </div>

    <SectHeading className="text-center">Наши программы</SectHeading>

    <div class="xl:hidden mb-10">
      {
        charityPrograms.map(c => (
          <article class="mb-4 last:mb-5 relative group">
            <a href={'/programs/' + c.slug} class="absolute inset-0" />
            <h3 class="text-lg mb-5 border-b border-dark/15">{c.name}</h3>
          </article>
        ))
      }
      <p class="mt-8">
        <Button variant="ghost" href="/programs">Узнать подробнее</Button>
      </p>
    </div>
    <div class="flex gap-16 xl:pr-8 flex-col-reverse xl:flex-row">
      <div class="flex-1 max-w-md md:max-w-full w-full mx-auto">
        {
          charityPrograms.map(c => (
            <img
              src={c.image}
              alt={c.name}
              class="relative [&:not(:first-child)]:-mt-8 md:[&:not(:first-child)]:-mt-16 aspect-video object-cover object-center [&:nth-child(1n)]:w-[270px] [&:nth-child(2n)]:w-[210px] [&:nth-child(3n)]:w-[190px] md:[&:nth-child(1n)]:w-[580px] md:[&:nth-child(2n)]:w-[465px] md:[&:nth-child(3n)]:w-[423px] [&:nth-child(2n)]:ml-auto [&:nth-child(2n)]:z-10 last:ml-[10%]"
            />
          ))
        }
      </div>
      <div class="max-w-lg flex-shrink-0 hidden xl:block">
        {
          charityPrograms.map(c => (
            <article class="mb-8 last:mb-12 relative group">
              <a href={'/programs/' + c.slug} class="absolute inset-0" />

              <h3 class="text-2xl font-medium mb-5 group-hover:underline underline-offset-8">
                {c.name}
              </h3>
              <div class="prose" set:html={c.description} />
            </article>
          ))
        }
        <div class="">
          <Button variant="ghost" href="/programs">Узнать подробнее</Button>
        </div>
      </div>
    </div>
  </div>
</section>

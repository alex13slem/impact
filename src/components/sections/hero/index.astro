---
import IMPACT from '@/assets/img/IMPACT.png';
import { headerOffsets } from '@/components/header';
import Nav from '@/components/russian-map/nav.svelte';
import { getMapNews } from '@/lib/data/mapNews';
import { getLastNews, type NewsItemWithRelated } from '@/lib/data/news';
import { fetchRegionsWithRelations } from '@/lib/data/regions';
import type { WardWithRelatedData } from '@/lib/data/wards';
import type { CharityProgram } from '@/lib/schemas/data/charityProgramsSchema';
import { cn } from '@/lib/utils';
import { Image } from 'astro:assets';
import RussianMap from '../../russian-map';
import Heading from './heading.svelte';

interface Props {
  wards: WardWithRelatedData[];
  news: NewsItemWithRelated[];
  charityPrograms: CharityProgram[];
}

const { wards, news, charityPrograms } = Astro.props;
const landingNews = getLastNews(news, 5);
const regions = await fetchRegionsWithRelations();
const mapNews = getMapNews(news, wards, regions);
---

<section
  id="hero"
  class="section-slide bg-dark relative z-0 overflow-x-clip"
  class:list={[headerOffsets.height]}
>
  <Image
    src={IMPACT}
    alt="impact"
    class="absolute inset-0 bottom-auto object-contain w-full -z-10"
    class:list={[headerOffsets.top]}
  />
  <RussianMap
    {mapNews}
    {regions}
    client:load
    className={cn(
      'absolute left-0 w-[max(100%,1200px)] h-svh z-0',
      headerOffsets.top,
    )}
  />
  <div
    class="container relative pointer-events-none z-10 px-0 xl:px-4 flex justify-end"
    class:list={[headerOffsets.height]}
  >
    <Nav
      client:load
      {charityPrograms}
      className="absolute left-0 pl-5 md:pl-6 z-10 pt-1 pointer-events-auto"
    />

    <Heading
      client:load
      className="absolute left-0 bottom-4 pointer-events-auto"
    />

    <aside
      class="hidden xl:block max-w-52 absolute right-0 xl:sticky top-4 text-right pointer-events-auto"
    >
      <h2 class="font-sov-mod text-2xl uppercase mb-6">
        <a href="/news">Новости</a>
      </h2>
      {
        landingNews.map(item => (
          <article class="[&:not(:last-child)]:mb-6 relative">
            <a href={`/news/${item.slug}`} class="absolute inset-0" />
            <time
              class="px-3 py-1 bg-dark rounded-full self-start text-xs"
              datetime={new Date(item.date).getDate().toString()}
            >
              {new Date(item.date).toLocaleDateString('ru-RU', {
                day: 'numeric',
                month: 'numeric',
                year: 'numeric',
              })}
            </time>
            <p class="text-sm mt-2">{item.title}</p>
          </article>
        ))
      }
    </aside>

    <button
      class="absolute top-1 right-0 xl:hidden flex justify-between items-center gap-1 text-accent text-opacity-90 border border-accent border-opacity-90 px-3 py-2 rounded-full leading-none mr-4 z-10 pointer-events-auto"
    >
      <a href="/news" class="absolute inset-0 opacity-0">news</a>
      Новости
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="1em"
        height="1em"
        viewBox="0 0 24 24"
        ><path
          fill="currentColor"
          d="M4 11v2h12l-5.5 5.5l1.42 1.42L19.84 12l-7.92-7.92L10.5 5.5L16 11z"
        ></path></svg
      >
    </button>

    <div class="absolute w-full h-full top-0 left-full pointer-events-auto">
    </div>
    <div class="absolute w-full h-full top-0 right-full pointer-events-auto">
    </div>
  </div>
</section>

---
import IMPACT from '@/assets/img/IMPACT.png';
import { charityPrograms } from '@/lib/data/charityPrograms';
import { mapNews } from '@/lib/data/mapNews';
import { getLastNews } from "@/lib/data/news";
import { Image } from "astro:assets";
import RussianMap from "../../russian-map";
import Heading from './heading.svelte';

const landingNews = getLastNews(5)

---

<script>
import { sectionSlide } from "@/lib/hooks/sectionSlide"
	const root = document.querySelector('#hero') as HTMLElement
	sectionSlide(root)
</script>

<section id="hero" class="section-slide bg-dark  relative z-0 overflow-x-clip">
	<!-- <Image src={BG} alt="abstract" class="absolute inset-0 object-cover w-full h-full -z-10" /> -->
	<Image src={IMPACT} alt="impact" class="absolute inset-0 -top-[53px] md:-top-[65px] lg:-top-[89px] bottom-auto object-contain w-full -z-10" />
	<div class="container grid grid-cols-2 min-h-[calc(100svh-53px)] md:min-h-[calc(100svh-65px)] lg:min-h-[calc(100svh-89px)] py-5 md:py-8 lg:py-10 px-0 relative z-0 ">

		<RussianMap {mapNews} {charityPrograms} client:load className="col-start-1 col-end-3 row-start-1 row-end-3"/>

		<Heading client:load className="self-end col-start-1 row-start-1 row-end-3 "/>

		<aside class="relative col-start-2 row-start-1 justify-self-end pr-4 hidden md:block max-w-52 " >
			<h2 class="font-sov-mod text-2xl uppercase mb-6">
				<a href="/news">Новости</a>
			</h2>
			{landingNews.map((item) => (
				<article class="flex flex-col gap-2 [&:not(:last-child)]:mb-6 relative">
					<a href={`/news/${item.slug}`} class="absolute inset-0"></a>
					<time class="px-3 py-1 bg-dark rounded-full self-start text-xs" datetime={new Date(item.date).getDate().toString()}>
						{new Date(item.date).toLocaleDateString('ru-RU', {
							day: 'numeric',
							month: 'numeric',
						})}
					</time>
					<p class="text-sm">{item.title}</p>
				</article>
			))}
		</aside>

		<button class="col-start-2 row-start-1 justify-self-end pr-4 self-start md:hidden flex justify-between items-baseline gap-1 text-accent text-opacity-90 relative border border-accent border-opacity-90 px-3 py-2 rounded-full leading-none mr-4">
			<a href="/news" class="absolute inset-0 opacity-0">news</a>
			Новости
			<svg width="9" height="8" viewBox="0 0 9 8" fill="none" xmlns="http://www.w3.org/2000/svg">
				<path d="M1.70497 0.675894H8.05675M8.05675 0.675894V7.02768M8.05675 0.675894L1.17565 7.557" stroke="currentColor"/>
			</svg>
		</button>

	</div>
</section>

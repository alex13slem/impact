---
import bg from '@/assets/img/our-mission-bg.png';
import SectHeadingAccent from '@/components/ui/sect-heading-accent.svelte';
import SectHeading from '@/components/ui/sect-heading.svelte';
import { Image } from 'astro:assets';

// const bg = await getImage({ src: bgSource });

const articles = [
  `<b class='text-accent'>Объединять людей</b> и компании
 для оказания необходимой помощи тем, кто в ней нуждается.`,
  `<b class='text-accent'>Дать силу сообществу</b>
и организациям для предоставления необходимой поддержки тем, кто в ней нуждается.`,
  `<b class='text-accent'>Создать платформу</b>
для сотрудничества между
людьми и организациями для предоставления важной помощи тем, кто в ней нуждается`,
];
---

<section
  id="our-mission"
  class="our-mission relative z-0 bg-center bg-cover overflow-x-clip xl:bg-fixed pt-8 md:pt-20"
>
  <div class="container">
    <SectHeading className="text-center">
      НАША <SectHeadingAccent>МИССИЯ</SectHeadingAccent>
    </SectHeading>
    <div class="xl:block flex flex-col pb-[60vw] lg:p-0">
      <div
        class="lg:max-w-md text-pretty py-8 lg:p-0 lg:h-[37svw] flex flex-col justify-center text-center lg:text-left"
      >
        {articles.map(art => <article class="mb-4 prose" set:html={art} />)}
      </div>

      <div
        class="absolute bottom-[-20vw] lg:bottom-[-13vw] right-0 lg:right-auto lg:left-1/2 w-[80svw] lg:w-[50svw]"
      >
        <Image class="w-full" src={bg} alt="" />
      </div>
    </div>
  </div>
</section>

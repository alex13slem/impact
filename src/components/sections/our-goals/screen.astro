---
import cursorFragment from "@/assets/img/cursor-fragment.svg";
import SectHeading from "@/components/ui/sect-heading.svelte";
import { cn } from "@/lib/utils";
import type { HTMLAttributes } from "astro/types";
import { Image } from 'astro:assets';
interface Props extends HTMLAttributes<'div'> {
  image: string
  description: string
  counter: number
}

const { image, description , counter, class: className } = Astro.props
---

<div class={cn(className, "screen flex flex-col justify-center lg:justify-end bg-cover bg-center py-8 relative z-0 min-w-[100vw] min-h-svh")} style={`background-image: url(${image});`}>
  <div class="absolute inset-0 bg-[#042A47A1] -z-10"/>
  <SectHeading className="text-center lg:hidden">
    НАШИ <span class="text-accent">ЦЕЛИ</span>
  </SectHeading>
  <div class="container flex justify-center flex-wrap lg:flex-nowrap">
    <p class="counter hidden-block dir-bottom text-9xl md:text-[50vmin] leading-none font-sov-mod tracking-tighter pr-6" data-count={counter}>0</p>
    <div class="pl-16 lg:pb-10 pt-10 w-fit self-start relative z-0">
      <article class="max-w-xl p-4 md:px-16 md:py-5 bg-gradient-to-tl from-gr-start via-gr-middle to-gr-end text-dark text-lg md:text-2xl rounded-3xl ">
        <Fragment set:html={description} />
      </article>
      <Image src={cursorFragment} alt="cursor" class="absolute -scale-y-[1] lg:scale-100 top-4 md:top-0 lg:top-auto lg:bottom-0 left-0 -z-10" />
    </div>
  </div>
</div>

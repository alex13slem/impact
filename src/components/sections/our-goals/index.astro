---
import screen1Src from '@/assets/img/goals-1.jpg';
import screen2Src from '@/assets/img/goals-2.jpg';
import screen3Src from '@/assets/img/goals-3.jpg';
import SectHeading from '@/components/ui/sect-heading.svelte';
import cursorFragment from "@/assets/img/cursor-fragment.svg"
import { getImage, Image } from 'astro:assets';
import Screen from './screen.astro';

const screenBg1 = await getImage({src: screen1Src})
const screenBg2 = await getImage({src: screen2Src})
const screenBg3 = await getImage({src: screen3Src})

const screenData = [
  {
    image: screenBg1.src,
    description: `
    <p>
      Привлечь в качестве партнеров
      Фонда не менее тридцати ключевых
      предприятий.
    </p>
    `,
    counter: 30
  },
  {
    image: screenBg2.src,
    description: `
    <p>
      Заключить соглашение о сотрудничестве
      с четырьмя крупнейшими медицинскими
      учреждениям России в области лечения
      тяжелобольных детей.
    </p>
    `,
    counter: 11
  },
  {
    image: screenBg3.src,
    description: `
    <p>
      Оказать помощь
      в профессиональной
      ориентации и социальной адаптации минимум ста детям, оказавшимся в трудной жизненной ситуации.
    </p>
    `,
    counter: 100
  }
]
---
<script>

import { isTouchDevice } from "@/lib/utils";
import { gsap } from "gsap";
import { ScrollTrigger } from "gsap/ScrollTrigger";

if (!isTouchDevice()) {

  gsap.registerPlugin(ScrollTrigger);

  const screens = document.querySelectorAll(".section-our-goals .screen");

  const horizontalScrollTween = gsap.to(".section-our-goals .horizontal-scroll-container", {
  xPercent: -100 * (screens.length - 1),
  ease: "none",
  scrollTrigger: {
    trigger: ".horizontal-scroll-container",
    pin: true,
    scrub: 1,
    anticipatePin: 1,
    end: () => "+=" + window.innerWidth * (screens.length - 1),
  },
});

  screens.forEach((section) => {

    // Создаём анимацию для каждой секции
    gsap.fromTo(section,
      { filter: "grayscale(100%)", opacity: 0.2 },
      {
        opacity: 1,
        filter: "grayscale(0%)",
        scrollTrigger: {
          trigger: section,
          containerAnimation: horizontalScrollTween,
          start: "left right",
          end: "right center",
          scrub: 1,
        },
      }
    );

    const counters = section.querySelectorAll(".counter");

    counters.forEach((counter) => {
      const el = counter as HTMLElement;
      const endValue = parseInt(el.getAttribute('data-count') || "0", 10);

      if (!isNaN(endValue)) {
        gsap.timeline({
          scrollTrigger: {
            trigger: section,
            containerAnimation: horizontalScrollTween,
            start: "+=300 right",
            end: "+=300 center",
            scrub: 1,
            once: true,
          }
        })
        .fromTo(el, { innerText: '0' }, {
            innerText: endValue,
            duration: 0.5,
            ease: "power1.out",
            snap: { innerText: 1 },
            immediateRender: false,
        });
      }


    });

  });




} else {
  console.log('is touch device');

  const screens = document.querySelectorAll(".section-our-goals .screen");
  screens.forEach((section) => {
    const counters = section.querySelectorAll(".counter");
    counters.forEach((counter) => {
      const el = counter as HTMLElement;
      const endValue = parseInt(el.getAttribute('data-count') || "0", 10);

      if (!isNaN(endValue)) {
        el.innerText = endValue.toString();
      }
    });
  });
}

</script>

<section class="section-our-goals relative z-0">
  <div class="heading-container absolute inset-0 z-20 pt-32 pb-[70vh]">
    <SectHeading className="text-center sticky top-32 hidden lg:block">
      НАШИ <span class="text-accent">ЦЕЛИ</span>
    </SectHeading>
  </div>
  <div class="horizontal-scroll-container flex flex-wrap lg:flex-nowrap h-svh relative z-0">
    {
      screenData.map((screen) => (
        <Screen {...screen} />
      ))
    }
  </div>
</section>

---
import Button from '@/components/ui/button.svelte';
import SectHeading from '@/components/ui/sect-heading.svelte';
import SvgScan from '@/components/ui/svg-scan.svelte';
import { getPayment } from '@/lib/data/payment';

const paymentData = await getPayment(Astro);
---

<section id="pay" class="pay relative overflow-clip z-10">
  <div
    class="container max-w-5xl flex flex-col justify-between pt-8 md:pt-32 lg:grid grid-cols-[auto,1fr] gap-10 lg:gap-28 text-center lg:text-left"
  >
    <div class="hidden-block dir-bottom relative">
      <img
        class="m-auto w-56 md:w-full max-w-sm h-full object-contain object-bottom"
        src={paymentData.image}
        alt={paymentData.link}
      />
      <!-- <IconHand class="absolute bottom-16 left-14 text-7xl text-accent animate-bounce" /> -->
      <SvgScan
        class="absolute left-0 right-0 mx-auto bottom-[105px] md:bottom-[190px] text-[8rem] md:text-[13rem] text-accent animate-ping-slow"
      />
    </div>
    <div
      class="flex flex-col justify-center items-center lg:items-start -order-1 lg:-order-none"
    >
      <SectHeading className=""
        >Как <span class="text-accent">помочь</span>
      </SectHeading>
      <p class="mb-10 text-sm md:text-lg font-thin max-w-lg">
        Вы можете внести свой вклад с помощью пожертвования или волонтерства.
        Для оплаты отсканируйте QR-код в мобильном приложении банка или штатной
        камерой телефона.
      </p>
      <Button href={paymentData.link} external>Помочь</Button>
    </div>
  </div>
</section>

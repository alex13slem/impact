---
import type { CharityProgram } from "@/lib/schemas/data/charityProgramsSchema";
import { Slider } from "./slider";
interface Props {
  charityPrograms: CharityProgram[];
}

const { charityPrograms } = Astro.props;
---

<section class="programs my-8 md:mt-10 md:mb-20 overflow-clip">
  <div class="container">
    <Slider {charityPrograms} client:load />
  </div>
</section>

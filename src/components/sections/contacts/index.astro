---
import svgMap from "@/assets/img/adress.svg";
import bgSource from "@/assets/img/bg.webp";
import svgMail from "@/assets/img/email.svg";
import svgOpenHours from "@/assets/img/open-hours.svg";
import svgPhone from "@/assets/img/tel.svg";
import SectHeading from "@/components/ui/sect-heading.svelte";
import { contacts } from "@/lib/data/contacts";
import { toAnchorPhoneNumber } from "@/lib/utils";
import { getImage, Image } from "astro:assets";


const bg = await getImage({src: bgSource})

const coords = contacts.mapCoords.trim().split(',').reverse().join(',').trim();
const mapUrl = new URL('https://static-maps.yandex.ru/v1');
const params = new URLSearchParams({
  lang: 'ru_RU',
  pt: `${coords},round`,
  z: 18..toString(),
  size: '630,355',
  apikey: import.meta.env.YANDEX_MAPS_API_KEY,
  theme: 'dark'
});
mapUrl.search = params.toString();
---



<section id="contacts" style={`background-image: url(${bg.src});`} class="contacts relative z-0 overflow-clip bg-cover bg-center bg-fixed">
  <div class="container py-8 md:py-20 lg:min-h-svh">
    <SectHeading className="text-center">Контакты</SectHeading>
    <p class="hidden-block dir-right text-sm md:text-base font-thin lg:text-lg text-center max-w-xl mx-auto mb-8 md:mb-10">
      Если у вас остались вопросы, мы с удовольствием
      вам ответим в рабочее время.
    </p>

    <!-- Desktop -->
    <div class="lg:grid grid-cols-[1fr,1fr,592px] grid-rows-[auto,auto,1fr] gap-x-16 gap-y-8 hidden">
      <div>
        <p class="text-sm md:text-base font-thin lg:text-lg lowercase mb-1">Телефон</p>
        <p class="text-4xl border-b-2 border-b-white"><a href={`tel:${toAnchorPhoneNumber(contacts.phone)}`}>{contacts.phone}</a></p>
      </div>
      <div>
        <p class="text-sm md:text-base font-thin lg:text-lg lowercase mb-1">Часы работы</p>
        <p class="text-4xl border-b-2 border-b-white">{contacts.openingHours}</p>
      </div>
      <div>
        <p class="text-sm md:text-base font-thin lg:text-lg lowercase mb-1">Социальные сети</p>
        <p class="text-3xl  flex gap-4">
          <a href={contacts.vk} target="_blank" class="flex gap-2 border-b-2 border-b-white">
            <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24"><path fill="currentColor" d="M4.26 4.26C3 5.532 3 7.566 3 11.64v.72c0 4.068 0 6.102 1.26 7.38C5.532 21 7.566 21 11.64 21h.72c4.068 0 6.102 0 7.38-1.26C21 18.468 21 16.434 21 12.36v-.72c0-4.068 0-6.102-1.26-7.38C18.468 3 16.434 3 12.36 3h-.72C7.572 3 5.538 3 4.26 4.26m1.776 4.218H8.1c.066 3.432 1.578 4.884 2.778 5.184V8.478h1.938v2.958c1.182-.126 2.43-1.476 2.85-2.964h1.932a5.72 5.72 0 0 1-2.628 3.738a5.92 5.92 0 0 1 3.078 3.756h-2.13c-.456-1.422-1.596-2.526-3.102-2.676v2.676h-.24c-4.104 0-6.444-2.808-6.54-7.488"/></svg>
            Вконтакте
          </a>
          <!-- <a href={contacts.telegram} target="_blank" class="flex gap-2 border-b-2 border-b-white">
            <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24"><path fill="currentColor" d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10s10-4.48 10-10S17.52 2 12 2m4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19c-.14.75-.42 1-.68 1.03c-.58.05-1.02-.38-1.58-.75c-.88-.58-1.38-.94-2.23-1.5c-.99-.65-.35-1.01.22-1.59c.15-.15 2.71-2.48 2.76-2.69a.2.2 0 0 0-.05-.18c-.06-.05-.14-.03-.21-.02c-.09.02-1.49.95-4.22 2.79c-.4.27-.76.41-1.08.4c-.36-.01-1.04-.2-1.55-.37c-.63-.2-1.12-.31-1.08-.66c.02-.18.27-.36.74-.55c2.92-1.27 4.86-2.11 5.83-2.51c2.78-1.16 3.35-1.36 3.73-1.36c.08 0 .27.02.39.12c.1.08.13.19.14.27c-.01.06.01.24 0 .38"/></svg>
            Телеграм
          </a> -->
        </p>
      </div>
      <div>
        <p class="text-sm md:text-base font-thin lg:text-lg lowercase mb-1">Адрес</p>
        <p class="text-3xl border-b-2 border-b-white mb-1">{contacts.city}</p>
        <p >{contacts.address}</p>
        <p>Индекс: {contacts.postIndex}</p>
      </div>
      <div class="col-span-2">
        <p class="text-sm md:text-base font-thin lg:text-lg lowercase mb-1">Электронная почта</p>
        <p class="text-3xl border-b-2 border-b-white"><a href={"mailto:" + contacts.email}>{contacts.email}</a></p>
      </div>
      <div class="bg-white aspect-video -col-start-1 -col-end-2 row-start-1 -row-end-1 rounded-3xl overflow-clip relative">
        <a href={contacts.mapLink} class="absolute inset-0" target="_blank"></a>
        <img class="w-full h-full object-cover object-center" src={mapUrl.toString()} alt="">
      </div>
    </div>

    <!-- Mobile -->
    <div class="lg:hidden">
      <div class="mb-4 flex gap-4 items-center">
        <Image class='w-8 md:w-16' src={svgMail} alt="icon" />
        <p><a href={'mailto:' + contacts.email}>{contacts.email}</a></p>
      </div>
      <div class="mb-4 flex gap-4 items-center">
        <Image class='w-8 md:w-16' src={svgOpenHours} alt="icon" />
        <p>{contacts.openingHours}</p>
      </div>
      <div class="mb-4 flex gap-4 items-center">
        <Image class='w-8 md:w-16' src={svgPhone} alt="icon" />
        <p><a href={"tel:" + toAnchorPhoneNumber(contacts.phone)}>{contacts.phone}</a></p>
      </div>
      <div class="mb-4 flex gap-4 items-center">
        <Image class='w-8 md:w-16' src={svgMap} alt="icon" />
        <p>{contacts.postIndex}, {contacts.city}, <br>{contacts.address}</p>
      </div>
      <!-- <a href={contacts.telegram} target="_blank" class="mb-4 flex gap-4 items-center w-fit">
        <div class="flex justify-center items-center text-3xl h-8 md:h-16 w-8 md:w-16 p-2 border md:border-2 rounded-full border-current text-accent"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="m11.985 15.408l3.242 3.686c1.2 1.365 1.801 2.048 2.43 1.881c.628-.166.844-1.064 1.275-2.861l2.39-9.968c.665-2.768.997-4.151.259-4.834s-2.017-.175-4.575.84L5.14 8.865c-2.046.813-3.069 1.219-3.134 1.917a1 1 0 0 0 0 .214c.063.699 1.084 1.108 3.128 1.927c.925.371 1.388.557 1.72.912q.056.06.108.124c.306.38.436.88.697 1.876l.489 1.867c.253.97.38 1.456.713 1.522s.622-.336 1.201-1.141zm0 0l-.317-.33c-.362-.378-.543-.566-.543-.8s.18-.423.543-.8l3.573-3.724" color="currentColor"/></svg></div>
        <p>Телеграм</p>
      </a> -->
      <a href={contacts.vk} target="_blank" class="mb-4 flex gap-4 items-center w-fit">
        <div class="flex justify-center items-center text-3xl h-8 md:h-16 w-8 md:w-16 p-2 border md:border-2 rounded-full border-current text-accent"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24"><path fill="currentColor" fill-rule="evenodd" d="M23.405 16.865a11.4 11.4 0 0 0-2.123-2.964a16 16 0 0 0-.905-.94l-.038-.037a19 19 0 0 1-.346-.344a29.7 29.7 0 0 0 3.01-5.238l.033-.074l.023-.078c.109-.363.233-1.053-.207-1.677c-.456-.644-1.185-.76-1.674-.76h-2.247a2.23 2.23 0 0 0-2.19 1.442a17.5 17.5 0 0 1-1.806 3.271V6.833c0-.34-.032-.91-.397-1.39c-.436-.576-1.067-.69-1.505-.69H9.467a1.813 1.813 0 0 0-1.85 1.682l-.003.045v.045c0 .485.192.843.346 1.068c.069.101.142.193.189.251l.01.013c.05.062.083.103.116.149c.088.118.213.302.249.776v1.473a19.8 19.8 0 0 1-1.751-3.792l-.008-.022l-.008-.021c-.122-.319-.317-.783-.708-1.137c-.456-.415-.996-.53-1.487-.53h-2.28c-.497 0-1.096.116-1.543.587C.3 5.804.25 6.36.25 6.654v.134l.028.13a19.4 19.4 0 0 0 3.801 8.02a10.15 10.15 0 0 0 7.893 4.692l.041.003h.042c.726 0 1.483-.063 2.052-.442c.767-.512.828-1.297.828-1.689v-1.138c.197.16.441.374.74.662c.362.362.65.676.897.95l.132.146c.192.214.381.425.553.598c.216.217.483.456.817.633c.363.191.744.278 1.148.278h2.281c.481 0 1.17-.114 1.655-.676c.528-.612.488-1.363.322-1.902l-.03-.097zm-5.72.106a26 26 0 0 0-.957-1.014l-.003-.003c-1.357-1.308-1.99-1.535-2.438-1.535c-.239 0-.502.026-.673.24a.8.8 0 0 0-.147.348a2.5 2.5 0 0 0-.032.444v2.051c0 .255-.042.362-.16.44c-.157.105-.492.19-1.211.19a8.65 8.65 0 0 1-6.752-4.052l-.008-.013l-.01-.012A17.9 17.9 0 0 1 1.75 6.63c.004-.13.032-.209.078-.257c.047-.05.162-.12.454-.12h2.28c.253 0 .385.056.48.141c.106.098.2.263.312.557c.56 1.646 1.316 3.186 2.033 4.318c.358.565.71 1.036 1.028 1.369c.159.166.314.304.463.402c.143.094.306.169.474.169c.088 0 .191-.01.29-.053a.52.52 0 0 0 .25-.232c.103-.188.132-.465.132-.828V8.723c-.053-.818-.3-1.279-.54-1.606a6 6 0 0 0-.15-.193l-.013-.016a3 3 0 0 1-.122-.16a.4.4 0 0 1-.085-.214a.313.313 0 0 1 .324-.282h3.595c.206 0 .275.05.31.097c.05.065.092.2.092.484v4.528c0 .538.248.902.608.902c.414 0 .713-.251 1.235-.773l.009-.01l.008-.009a19 19 0 0 0 2.84-4.722l.004-.012a.73.73 0 0 1 .74-.485h2.3c.312 0 .414.08.448.127c.035.05.06.157 0 .367a28.2 28.2 0 0 1-3.029 5.2l-.008.012c-.115.177-.242.373-.26.597c-.02.242.084.461.267.697c.133.196.408.465.687.738l.026.026c.292.286.609.596.863.896l.007.007l.007.008a9.9 9.9 0 0 1 1.865 2.586c.076.26.03.394-.03.463c-.069.08-.224.155-.518.155h-2.282a.9.9 0 0 1-.447-.105a2 2 0 0 1-.454-.364c-.143-.143-.298-.316-.488-.527z" clip-rule="evenodd"/></svg></div>
        <p>Вконтакте</p>
      </a>
      <div class="bg-white aspect-video rounded-2xl mt-8 overflow-clip relative">
        <a href={contacts.mapLink} class="absolute inset-0" target="_blank"></a>
        <img class="w-full h-full object-cover object-center" src={mapUrl.toString()} alt="">
      </div>
    </div>
  </div>

</section>




---
import svgMap from "@/assets/img/adress.svg";
import svgMail from "@/assets/img/email.svg";
import svgOpenHours from "@/assets/img/open-hours.svg";
import svgPhone from "@/assets/img/tel.svg";
import IconTg from "@/components/ui/icons/icon-tg.svelte";
import IconVk from "@/components/ui/icons/icon-vk.svelte";
import SectHeading from "@/components/ui/sect-heading.svelte";
import { fetchContacts } from "@/lib/data/contacts";
import { toAnchorPhoneNumber } from "@/lib/utils";
import { Image } from "astro:assets";

const contacts = await fetchContacts();
const coords = contacts.mapCoords.trim().split(",").reverse().join(",").trim();
const mapUrl = new URL("https://static-maps.yandex.ru/v1");
const params = new URLSearchParams({
  lang: "ru_RU",
  pt: `${coords},round`,
  z: (18).toString(),
  size: "630,355",
  apikey: import.meta.env.YANDEX_MAPS_API_KEY,
  theme: "dark",
});
mapUrl.search = params.toString();
---

<section id="contacts" class="contacts relative z-0 overflow-clip">
  <div class="container py-8 md:py-20">
    <SectHeading className="text-center">Контакты</SectHeading>
    <p
      class="hidden-block dir-bottom text-sm md:text-base font-thin lg:text-lg text-center max-w-xl mx-auto mb-8 md:mb-10"
    >
      Если у вас остались вопросы, мы с удовольствием вам ответим в рабочее
      время.
    </p>

    <!-- Desktop -->
    <div
      class="xl:grid grid-cols-[1fr,1fr,592px] grid-rows-[auto,auto,1fr] gap-x-16 gap-y-8 hidden"
    >
      <div>
        <p class="text-sm md:text-base font-thin lg:text-lg lowercase mb-1">
          Телефон
        </p>
        <p class="text-4xl border-b-2 border-b-white">
          <a href={`tel:${toAnchorPhoneNumber(contacts.phone)}`}
            >{contacts.phone}</a
          >
        </p>
      </div>
      <div>
        <p class="text-sm md:text-base font-thin lg:text-lg lowercase mb-1">
          Часы работы
        </p>
        <p class="text-4xl border-b-2 border-b-white">
          {contacts.openingHours}
        </p>
      </div>
      <!-- <div>
        <p class="text-sm md:text-base font-thin lg:text-lg lowercase mb-1">
          Социальные сети
        </p>
        <p class="text-3xl flex gap-4">
          <a
            href={contacts.vk}
            target="_blank"
            class="flex gap-2 border-b-2 border-b-white"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="1em"
              height="1em"
              viewBox="0 0 24 24"
              ><path
                fill="currentColor"
                d="M4.26 4.26C3 5.532 3 7.566 3 11.64v.72c0 4.068 0 6.102 1.26 7.38C5.532 21 7.566 21 11.64 21h.72c4.068 0 6.102 0 7.38-1.26C21 18.468 21 16.434 21 12.36v-.72c0-4.068 0-6.102-1.26-7.38C18.468 3 16.434 3 12.36 3h-.72C7.572 3 5.538 3 4.26 4.26m1.776 4.218H8.1c.066 3.432 1.578 4.884 2.778 5.184V8.478h1.938v2.958c1.182-.126 2.43-1.476 2.85-2.964h1.932a5.72 5.72 0 0 1-2.628 3.738a5.92 5.92 0 0 1 3.078 3.756h-2.13c-.456-1.422-1.596-2.526-3.102-2.676v2.676h-.24c-4.104 0-6.444-2.808-6.54-7.488"
              ></path></svg
            >
            Вконтакте
          </a>
          <a href={contacts.telegram} target="_blank" class="flex gap-2 border-b-2 border-b-white">
            <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24"><path fill="currentColor" d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10s10-4.48 10-10S17.52 2 12 2m4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19c-.14.75-.42 1-.68 1.03c-.58.05-1.02-.38-1.58-.75c-.88-.58-1.38-.94-2.23-1.5c-.99-.65-.35-1.01.22-1.59c.15-.15 2.71-2.48 2.76-2.69a.2.2 0 0 0-.05-.18c-.06-.05-.14-.03-.21-.02c-.09.02-1.49.95-4.22 2.79c-.4.27-.76.41-1.08.4c-.36-.01-1.04-.2-1.55-.37c-.63-.2-1.12-.31-1.08-.66c.02-.18.27-.36.74-.55c2.92-1.27 4.86-2.11 5.83-2.51c2.78-1.16 3.35-1.36 3.73-1.36c.08 0 .27.02.39.12c.1.08.13.19.14.27c-.01.06.01.24 0 .38"/></svg>
            Телеграм
          </a>
        </p>
      </div> -->
      <div class="">
        <p class="text-sm md:text-base font-thin lg:text-lg lowercase mb-1">
          Электронная почта
        </p>
        <p class="text-3xl border-b-2 border-b-white">
          <a href={"mailto:" + contacts.email}>{contacts.email}</a>
        </p>
      </div>
      <div>
        <p class="text-sm md:text-base font-thin lg:text-lg lowercase mb-1">
          Адрес
        </p>
        <p class="text-3xl border-b-2 border-b-white mb-1">{contacts.city}</p>
        <p>{contacts.address}</p>
        <p>Индекс: {contacts.postIndex}</p>
      </div>

      <div
        class="bg-white aspect-video -col-start-1 -col-end-2 row-start-1 -row-end-1 rounded-3xl overflow-clip relative"
      >
        <a href={contacts.mapLink} class="absolute inset-0" target="_blank"></a>
        <img
          class="w-full h-full object-cover object-center"
          src={mapUrl.toString()}
          alt=""
        />
      </div>
    </div>

    <!-- Mobile -->
    <div class="xl:hidden flex lg:flex-row flex-col gap-6">
      <div>
        <div class="mb-4 flex gap-4 items-center">
          <Image class="w-8 md:w-16" src={svgMail} alt="icon" />
          <p><a href={"mailto:" + contacts.email}>{contacts.email}</a></p>
        </div>
        <div class="mb-4 flex gap-4 items-center">
          <Image class="w-8 md:w-16" src={svgOpenHours} alt="icon" />
          <p>{contacts.openingHours}</p>
        </div>
        <div class="mb-4 flex gap-4 items-center">
          <Image class="w-8 md:w-16" src={svgPhone} alt="icon" />
          <p>
            <a href={"tel:" + toAnchorPhoneNumber(contacts.phone)}
              >{contacts.phone}</a
            >
          </p>
        </div>
        <div class="mb-4 flex gap-4 items-center">
          <Image class="w-8 md:w-16" src={svgMap} alt="icon" />
          <p>{contacts.postIndex}, {contacts.city}, <br />{contacts.address}</p>
        </div>
      </div>

      <div class="bg-white aspect-video rounded-2xl overflow-clip relative">
        <a href={contacts.mapLink} class="absolute inset-0" target="_blank"></a>
        <img
          class="w-full h-full object-cover object-center"
          src={mapUrl.toString()}
          alt=""
        />
      </div>
    </div>

    <div class="flex justify-center mt-12 gap-4">
      <a href={contacts.vk}>
        <IconVk class="text-6xl" />
      </a>

      <a href={contacts.telegram}>
        <IconTg class="text-6xl" />
      </a>
    </div>
  </div>
</section>

---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"head"> {}

const { ...props } = Astro.props;
---

<head {...props}>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
  />

  <meta name="generator" content={Astro.generator} />

  <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <meta name="apple-mobile-web-app-title" content="Благодействие" />
  <link rel="manifest" href="/site.webmanifest" />

  <!-- <script src="https://api-maps.yandex.ru/v3/?apikey=1a8eeb00-6b85-405c-bf6f-bada69c3bc2b&lang=ru_RU"></script> -->

  <slot />
</head>

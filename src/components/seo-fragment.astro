---
import type { OpenGraphProps } from '@/lib/types/open-graph';
import OpenGraph from './open-graph.astro';

interface Props extends Omit<OpenGraphProps, 'siteName'> {
  keywords?: string;
  noindex?: boolean;
}

const {
  keywords,
  description: _description,
  title,
  noindex = false,
  ...props
} = Astro.props;

const siteNameEnv = import.meta.env.SITE_NAME_TAB;
// const mainInfoData = await getMainInfo();

const siteName = siteNameEnv ||  '';
const description =
  _description ||  '';
---

<>
  {keywords && <meta name="keywords" content={keywords} />}
  <meta name="description" content={description} />
  <OpenGraph {description} {title} {siteName} {...props} />
  {noindex && <meta name="robots" content="noindex" />}
  <title>{siteName} · {title}</title>
</>
